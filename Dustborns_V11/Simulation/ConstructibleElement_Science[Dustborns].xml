<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/ScienceConstructibleElement.xsd">

    <!-- ============================================================================
         СОБСТВЕННЫЕ ТЕХНОЛОГИИ ПЫЛЕРОЖДЁННЫХ  (v3.0)

         В v3.0 ветки «Сухая Жатва» (еда -> пыль) и «Переваривание» (+300 пыли за
         жителя) ПЕРЕЕХАЛИ в ванильные технологии: для Пылерождённых созданы
         ВАРИАНТЫ технологий (файл ConstructibleElement_Science[VanillaTechs].xml),
         которые встают вместо оригиналов в дереве (механика Горацио/Софонов).
         «Армированные Оболочки» удалены: их бонусы разложены на «Автономное
         строительство» и «Упрочнённые сплавы» (+1 производства Безвольным).

         Здесь остаются только:
           - TechnologyDustbornFoodToDust0 «Первый Голод» (эра 1, скрытая,
             разблокировка механики еда->пыль, награда главы 1 главного квеста);
           - TechnologyDustbornDepletion1 «Терпеливые Ветра» (эра 2, истощение
             -0.1 за каждого Пылерождённого на планете).
         ============================================================================ -->

    <!-- ВЕТКА: КОНВЕРСИЯ ЕДЫ В ПЫЛЬ (РАЗБЛОКИРОВКА)  ->  КВАДРАНТ «ЭКОНОМИКА И ТОРГОВЛЯ»
         «Первый Голод»: скрытая технология, выдаётся наградой главы 1 квеста
         (Action_UnlockTechnology). Разблокирует механику и даёт первые +25%. -->
    <TechnologyDefinition Name="TechnologyDustbornFoodToDust0" TechnologyStage="TechnologyStageDefinitionEconomyAndTrade1" Category="CategoryTechnologyEconomyAndTrade" ScoreProvider="TechnologyUnlocked" TechnologyFlags="Affinity" Visibility="Hidden">
        <Tags>NoOmniscience</Tags>
        <CustomCost ResourceName="EmpireResearch">Property(StockLocation,@'ClassEmpire/ClassResearch', TechnologyCurrentCost) * Property(StockLocation,@'ClassEmpire/ClassResearch', TechnologyCostStage1Multiplier) * Property(StockLocation,@'ClassEmpire/ClassResearch', TechnologyCostQuadrantEconomyAndTradeMultiplier)</CustomCost>
        <PathPrerequisite Flags="Prerequisite,Discard,DiplomaticTradable,Faction,AffinityDustborns">ClassEmpire,AffinityMappingDustborns</PathPrerequisite>
        <SimulationDescriptorReference Name="TechnologyCountEconomyAndTradeIncreaseStage1"/>
        <SimulationDescriptorReference Name="TechnologyDustbornFoodToDust0"/>
        <SimulationDescriptorReference Name="TechnologyCounter"/>
        <HelperVariable Name="TurnVariable"/>
        <HelperFormula>15 * $(TurnVariable) + 5</HelperFormula>
    </TechnologyDefinition>

    <!-- ВЕТКА: ИСТОЩЕНИЕ  ->  КВАДРАНТ «НАУКА И ИССЛЕДОВАНИЕ»
         «Терпеливые Ветра» (эра 2): -0.1 истощения ЗА КАЖДОГО Пылерождённого
         на планете (свойство DustbornPatientWindsReduction ставится на трейт
         Primary; вычет делает бинарный модификатор в трейте). -->
    <TechnologyDefinition Name="TechnologyDustbornDepletion1" TechnologyStage="TechnologyStageDefinitionScienceAndExploration2" Category="CategoryTechnologyScienceAndExploration" ScoreProvider="TechnologyUnlocked" TechnologyFlags="Affinity">
        <Tags>NoOmniscience</Tags>
        <CustomCost ResourceName="EmpireResearch">Property(StockLocation,@'ClassEmpire/ClassResearch', TechnologyCurrentCost) * Property(StockLocation,@'ClassEmpire/ClassResearch', TechnologyCostStage2Multiplier) * Property(StockLocation,@'ClassEmpire/ClassResearch', TechnologyCostQuadrantScienceAndExplorationMultiplier)</CustomCost>
        <PathPrerequisite Flags="Prerequisite,Discard,DiplomaticTradable,Faction,AffinityDustborns">ClassEmpire,AffinityMappingDustborns</PathPrerequisite>
        <SimulationDescriptorReference Name="TechnologyCountScienceAndExplorationIncreaseStage2"/>
        <SimulationDescriptorReference Name="TechnologyDustbornDepletion1"/>
        <SimulationDescriptorReference Name="TechnologyCounter"/>
        <HelperVariable Name="TurnVariable"/>
        <HelperFormula>20 * $(TurnVariable) + 5</HelperFormula>
    </TechnologyDefinition>

</Datatable>
