        <TechnologyPrerequisite Flags="Prerequisite,Link,Disable">TechnologyDustbornFoodToDust1</TechnologyPrerequisite>
        <SimulationDescriptorReference Name="TechnologyCountEconomyAndTradeIncreaseStage3"/>
