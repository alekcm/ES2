<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/IndustryConstructibleElement.xsd">
    <!-- Покупка Пылерождённого за пыль -->
    <StarSystemPopulationTransformImprovementDefinition Name="StarSystemImprovementCreateMajorPopulationDustborns" SubCategory="SubCategoryPopulation" ScoreProvider="StarSystemImprovementBuilt"
                                                      PopulationDestination="Major" PopulationToTransformCount="1" CreateIfNotAvailable="true" ConsumeResourceSurplus="true">
        <AIGain RessourceName="PopulationGain" Inverted="false"></AIGain>
        <SupervisorGain Name="Dust" Weight="0.5"/>
        <Tags>NoBuyout</Tags>
        <QueuedSimulationDescriptorReference Name="QueuedDescriptorIncreaseVirtualPopulationDustborns"/>
        <CustomCost ResourceName="EmpireMoney" Instant="true">250 * Property(StockLocation, @../ClassEmpire, GameSpeedMultiplier, true)</CustomCost>
        <PathPrerequisite Inverted="false" Flags="Prerequisite,Discard">ClassColonizedStarSystem</PathPrerequisite>
        <PathPrerequisite Inverted="false" Flags="Prerequisite,Discard">../ClassEmpire/PopulationMajor,ClassPopulationEmpireAffinityDustborns</PathPrerequisite>
        <InterpreterPrerequisite Flags="MaximumPopulationSystem,Enqueue">(Property(Context,@ClassColonizedStarSystem, MaximumPopulation) ge (1 + Property(Context,@ClassColonizedStarSystem, Population) + Property(Context,@ClassColonizedStarSystem, VirtualPopulation)))</InterpreterPrerequisite>
        <InterpreterPrerequisite Flags="Prerequisite">(Property(Context,@ClassColonizedStarSystem, MaximumPopulation) ge (Property(Context,@ClassColonizedStarSystem, Population) + Property(Context,@ClassColonizedStarSystem, VirtualPopulation)))</InterpreterPrerequisite>
        <SimulationDescriptorReference Name="StarSystemImprovementCreateMajorPopulationDustborns"/>
    </StarSystemPopulationTransformImprovementDefinition>

    <!-- Покупка Безвольных за пыль удалена: Безвольные получаются ТОЛЬКО переработкой чужого населения -->

    <!-- v3.0: «Распылить Пылерождённого» (StarSystemImprovementSellMajorPopulationDustborns)
         УДАЛЕНО полностью (постройка, дескриптор, GuiElement, локализация).
         Пылерождённых больше нельзя распылять обратно в производство. -->

    <!-- Бесплатная постройка "Сконструировать Безвольного" (Home) также удалена -->

    <!-- Конверсия минора в Безвольного +300 пыли, требует Пылерождённого.
         Паттерн взят из ванильной постройки Хоратио "Clone Major Population"
         (StarSystemPopulationTransformImprovementDefinition PopulationSource="Minor"
         PopulationDestination="Major"): корректные пути к минорной популяции -
         ColonizedStarSystemStateColony/ClassColonizedPlanet/PopulationNonMajor. -->
    <StarSystemPopulationTransformImprovementDefinition Name="StarSystemImprovementConvertToBezvolny" SubCategory="SubCategoryPopulation" ScoreProvider="StarSystemImprovementBuilt"
                                                      PopulationSource="Minor" PopulationSourceHeuristic="LowestCount"
                                                      PopulationDestination="AffinityBezvolny" PopulationDestinationHeuristic="LowestCount"
                                                      PopulationToTransformCount="1" CreateIfNotAvailable="true" ConsumeResourceSurplus="true">
        <AIGain RessourceName="PopulationGain" Inverted="false"></AIGain>
        <SupervisorGain Name="Industry" Weight="0.5"/>
        <Tags>NoBuyout</Tags>
        <Cost ResourceName="SystemTurnBased">1</Cost>
        <!-- В системе есть Пылерождённые -->
        <PathPrerequisite Inverted="false" Flags="Prerequisite,Discard">ClassColonizedStarSystem/ClassPopulationStarSystemAffinityDustborns</PathPrerequisite>
        <!-- На планете колонии есть не-мажорная (минорная) популяция -->
        <PathPrerequisite Inverted="false" Flags="Prerequisite,Disable">ColonizedStarSystemStateColony/ClassColonizedPlanet/PopulationNonMajor</PathPrerequisite>
        <!-- Есть кого переваривать: не-мажорное население минус Безвольные и Считающие Оболочки.
             Самих Безвольных и Оболочек переваривать нельзя (IsInvincible): они уже переварены,
             повторная переработка бессмысленна и в прежних версиях «съедала» собственных оболочек. -->
        <InterpreterPrerequisite Inverted="false" Flags="NotEnoughPopulation,Enqueue">(Property(Context, @ClassColonizedStarSystem, Population) - Property(Context, @ClassColonizedStarSystem, MajorPopulationCount) - Property(Context, @'ClassColonizedStarSystem/ClassPopulation,ClassPopulationStarSystemAffinityBezvolnyCount', PopulationCount, true) - Property(Context, @'ClassColonizedStarSystem/ClassPopulation,ClassPopulationStarSystemAffinityBezvolnyScholarCount', PopulationCount, true)) gt 0</InterpreterPrerequisite>
        <SimulationDescriptorReference Name="StarSystemImprovementConvertToBezvolny"/>
        <TemporaryEffect>BezvolnyDustReward</TemporaryEffect>
    </StarSystemPopulationTransformImprovementDefinition>

    <!-- ============ 2.10 ПЕРЕРАБОТКА В СЧИТАЮЩУЮ ОБОЛОЧКУ ============
         Альтернатива обычной переработке: пыль НЕ даётся, вместо Безвольного - Считающая Оболочка.
         Доступна только после разблокировки квестом (флаг EmpireUnlockedScholarShells). -->
    <StarSystemPopulationTransformImprovementDefinition Name="StarSystemImprovementConvertToScholar" SubCategory="SubCategoryPopulation" ScoreProvider="StarSystemImprovementBuilt"
                                                      PopulationSource="Minor" PopulationSourceHeuristic="LowestCount"
                                                      PopulationDestination="AffinityBezvolnyScholar" PopulationToTransformCount="1" CreateIfNotAvailable="true" ConsumeResourceSurplus="true">
        <AIGain RessourceName="PopulationGain" Inverted="false"></AIGain>
        <SupervisorGain Name="Science" Weight="0.5"/>
        <Tags>NoBuyout</Tags>
        <Cost ResourceName="SystemTurnBased">1</Cost>
        <PathPrerequisite Inverted="false" Flags="Prerequisite,Discard">ClassColonizedStarSystem/ClassPopulationStarSystemAffinityDustborns</PathPrerequisite>
        <PathPrerequisite Inverted="false" Flags="Prerequisite,Discard">ClassColonizedStarSystem/PopulationMinor</PathPrerequisite>
        <PathPrerequisite Inverted="false" Flags="Prerequisite,Discard">../ClassEmpire,EmpireUnlockedScholarShells</PathPrerequisite>
        <!-- Есть кого переваривать: Безвольные и Считающие Оболочки не считаются (IsInvincible) -->
        <InterpreterPrerequisite Inverted="false" Flags="NotEnoughPopulation,Enqueue">(Property(Context, @ClassColonizedStarSystem, Population) - Property(Context, @ClassColonizedStarSystem, MajorPopulationCount) - Property(Context, @'ClassColonizedStarSystem/ClassPopulation,ClassPopulationStarSystemAffinityBezvolnyCount', PopulationCount, true) - Property(Context, @'ClassColonizedStarSystem/ClassPopulation,ClassPopulationStarSystemAffinityBezvolnyScholarCount', PopulationCount, true)) gt 0</InterpreterPrerequisite>
        <SimulationDescriptorReference Name="StarSystemImprovementConvertToScholar"/>
        <TemporaryEffect>ScholarDustReward</TemporaryEffect>
    </StarSystemPopulationTransformImprovementDefinition>

    <!-- ============ 4-B АБРАЗИВНЫЙ СТАН ============
         Требует истощённую планету в системе. Даёт +10% силы армии, пока стоит. -->
    <StarSystemImprovementDefinition Name="StarSystemImprovementAbrasiveForge" SubCategory="SubCategoryEmpire" ScoreProvider="StarSystemImprovementBuilt">
        <SupervisorGain Name="Industry" Weight="0.5"/>
        <UniqueTags>AbrasiveForge</UniqueTags>
        <CustomCost ResourceName="SystemProduction">400 * Property(StockLocation, @../ClassEmpire, GameSpeedMultiplier, true)</CustomCost>
        <PathPrerequisite Inverted="false" Flags="Prerequisite,Discard">../ClassEmpire,DustbornRewardAbrasiveForge</PathPrerequisite>
        <PathPrerequisite Inverted="false" Flags="Prerequisite">ClassColonizedStarSystem/ClassColonizedPlanet,PlanetDepletionMalus</PathPrerequisite>
        <SimulationDescriptorReference Name="StarSystemImprovementAbrasiveForge"/>
    </StarSystemImprovementDefinition>

    <!-- ============ 5-A КУРГАН ОСЕВШИХ ============
         +4 производства ЛЮБОМУ населению на истощённых планетах этой системы. -->
    <StarSystemImprovementDefinition Name="StarSystemImprovementSettledBarrow" SubCategory="SubCategoryEmpire" ScoreProvider="StarSystemImprovementBuilt">
        <SupervisorGain Name="Industry" Weight="0.7"/>
        <UniqueTags>SettledBarrow</UniqueTags>
        <CustomCost ResourceName="SystemProduction">300 * Property(StockLocation, @../ClassEmpire, GameSpeedMultiplier, true)</CustomCost>
        <PathPrerequisite Inverted="false" Flags="Prerequisite,Discard">../ClassEmpire,DustbornRewardSettledBarrow</PathPrerequisite>
        <PathPrerequisite Inverted="false" Flags="Prerequisite">ClassColonizedStarSystem/ClassColonizedPlanet,PlanetDepletionMalus</PathPrerequisite>
        <SimulationDescriptorReference Name="StarSystemImprovementSettledBarrow"/>
    </StarSystemImprovementDefinition>

</Datatable>
