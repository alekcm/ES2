    <!-- ============================================================================
         ПЕРЕОПРЕДЕЛЕНИЕ ВАНИЛЬНЫХ ТЕХНОЛОГИЙ + ВАРИАНТЫ ПЫЛЕРОЖДЁННЫХ  (v3.0)

         Механика (как у вариантов Горацио/Софонов в ванильной игре):
         1) Базовая технология получает ОБРАТНОЕ (Inverted) требование аффинити
            Пылерождённых - чтобы Пылерождённые не могли исследовать оригинал.
         2) Создаётся ВАРИАНТ технологии (Имя + "Dustborns") с прямым требованием
            AffinityMappingDustborns - его видят и исследуют только Пылерождённые.
         3) Вариант повторяет все эффекты оригинала и дополнительно ссылается
            на дескриптор с бонусом фракции (конверсия еды в Пыль / переваривание /
            производство Безвольных). Описание варианта содержит новый "раздел"
            с текстом бонуса.
         ============================================================================ -->


    <!-- ===== TechnologyDefinitionEmpireDevelopment2 : базовое определение (оригинал + исключение Пылерождённых) ===== -->
<TechnologyDefinition Name="TechnologyDefinitionEmpireDevelopment2" TechnologyStage="TechnologyStageDefinitionEmpireDevelopment1" Category="CategoryTechnologyEmpireDevelopment" ScoreProvider="TechnologyUnlocked">
    <CustomCost ResourceName="EmpireResearch">Property(StockLocation,@'ClassEmpire/ClassResearch', TechnologyCurrentCost) * Property(StockLocation,@'ClassEmpire/ClassResearch', TechnologyCostStage1Multiplier) * Property(StockLocation,@'ClassEmpire/ClassResearch', TechnologyCostQuadrantEmpireDevelopmentMultiplier)</CustomCost>
        <PathPrerequisite Flags="Prerequisite,DiplomaticTradable,Discard" Inverted="true">ClassEmpire,AffinityMappingDustborns</PathPrerequisite>
    <SimulationDescriptorReference Name="TechnologyUniqueFood1"/>
    <SimulationDescriptorReference Name="TechnologyCountEmpireDevelopmentIncreaseStage1"/>
    <SimulationDescriptorReference Name="TechnologyCounter"/>
    <PopulationEvent Name="PopulationPoliticalEventEcologistTechnology"/>

    <HelperVariable Name="FoodVariable"/>
    <HelperVariable Name="AvailablePlanets"/>
    <HelperVariable Name="AvailableHotPlanets"/>
    <HelperVariable Name="AvailableColdPlanets"/>
    <HelperFormula>(10 * $(AvailablePlanets) + 5 * $(AvailableHotPlanets) +5 * $(AvailableColdPlanets)) *$(FoodVariable)</HelperFormula>
  </TechnologyDefinition>

