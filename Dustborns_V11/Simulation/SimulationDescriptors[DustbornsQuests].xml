    </SimulationDescriptor>
    <SimulationDescriptor Name="TechnologyDustbornDigestion3" Type="Technology">
        <Modifier TargetProperty="DustbornDigestionValue" Operation="Addition" Value="300" Path="../ClassEmpire" TooltipHidden="false"/>
    </SimulationDescriptor>

    <!-- Ветка C -->
    <!-- Терпеливые Ветра: НЕ плоские -0.1 ко всем планетам, а -0.1 ЗА КАЖДОГО Пылерождённого
         на планете. Реализация: техника ставит свойство DustbornPatientWindsReduction=0.1
         на трейт Primary каждого Пылерождённого; сам вычет делает бинарник в трейте
         (PlanetDepletionPerTurn -= 0.1 × PopulationCount на планету). -->
    <SimulationDescriptor Name="TechnologyDustbornDepletion1" Type="Technology">
        <Modifier TargetProperty="DustbornPatientWindsReduction" Operation="Force" Value="0.1" Path="../ClassEmpire/ClassColonizedStarSystem/ClassColonizedPlanet/ClassPopulation,ClassPopulationPlanetModifiersTraitDustbornsPrimary" TooltipHidden="true"/>
