        <Modifier TargetProperty="BonusPopulationIndustry" Operation="Addition" Value="1" Path="ClassEmpire/ClassColonizedStarSystem/ClassColonizedPlanet/ClassPopulation,ClassPopulationPlanetModifiersTraitBezvolnyPrimary" TooltipHidden="false"/>
    </SimulationDescriptor>
    <SimulationDescriptor Name="PopulationCollectionBonusBezvolny20" Type="PopulationCollectionBonus">
