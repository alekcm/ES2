    <!-- ==========================================================================
         DUSTBORN PRIMARY
         База сбора пыли: 4 обычная / 8 Teeming / 0 Стерильная.
         Растёт от Каталога Миров (§0.1): +2 обычная, +4 Teeming за каждый уникальный
         истощённый тип планеты. Стерильные открываются наградой этапа 3-C.
         ========================================================================== -->
    <SimulationDescriptor Name="ClassPopulationPlanetModifiersTraitDustbornsPrimary" Type="ClassPopulationPlanet">
        <Property Name="BonusFromDepletion" BaseValue="1"/>

        <!-- Ставки замедления истощения (множитель: число Пылерождённых на планете).
             DustbornPatientWindsReduction: техника «Терпеливые Ветра» (Force 0.1).
             DustbornIceReduction: запись Каталога за ледяной мир (Force 0.05). -->
        <Property Name="DustbornPatientWindsReduction" BaseValue="0" MinValue="0" MaxValue="1"/>
        <Property Name="DustbornIceReduction" BaseValue="0" MinValue="0" MaxValue="1"/>

        <!-- Флаг награды этапа 3-C "Скупая Мудрость": разрешает сбор со Стерильных -->
        <Property Name="DustbornMeagerUnlocked" BaseValue="0" MinValue="0" MaxValue="1"/>

        <!-- Итоговые ставки сбора. Растут только от записей Каталога Миров:
             богатые миры (+2/+4) и умеренные (+1/+2) - через дескрипторы-награды
             DustbornCatalogRichDust / DustbornCatalogModerateDust. -->
        <Property Name="DustbornDustBaseNormal" BaseValue="4" MinValue="0"/>
        <Property Name="DustbornDustBaseTeeming" BaseValue="4" MinValue="0"/>
        <Property Name="DustbornDustBaseMeager" BaseValue="0" MinValue="0"/>

        <!-- Истощение -->
        <Modifier TargetProperty="PlanetDepletionPerTurn" Operation="Addition" Value="1" Path="False/./ClassPlanet"/>
        <BinaryModifier TargetProperty="PlanetDepletionPerTurn" Operation="Addition" Left="1" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="./ClassPlanet" TooltipHidden="true"/>
        <!-- «Терпеливые Ветра»: −0.1 × Пылерождённых (свойство ставит техника) -->
        <BinaryModifier TargetProperty="PlanetDepletionPerTurn" Operation="Subtraction" Left="$(DustbornPatientWindsReduction)" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="./ClassPlanet" TooltipHidden="true"/>
        <!-- Каталог: ледяной мир: −0.05 × Пылерождённых (свойство ставит награда) -->
        <BinaryModifier TargetProperty="PlanetDepletionPerTurn" Operation="Subtraction" Left="$(DustbornIceReduction)" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="./ClassPlanet" TooltipHidden="true"/>
        <Modifier TargetProperty="BonusFromDepletion" Operation="Force" Value="0" TooltipHidden="true" Priority="-1"/>

        <!-- Штраф промышленности: -10% за каждого Пылерождённого на планете -->
        <BinaryModifier TargetProperty="PlanetIndustry" Operation="Percent" Left="-0.1" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="./ClassPlanet" Priority="10" TooltipHidden="false"/>
        <BinaryModifier TargetProperty="NetPlanetIndustry" Operation="Percent" Left="-0.1" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="./ClassPlanet" Priority="10" TooltipHidden="true"/>

        <!-- Сбор пыли на не-Стерильной планете, только пока не истощена -->
        <BinaryModifier TargetProperty="BonusPopulationDust" Operation="Addition" Left="$(DustbornDustBaseNormal)" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
        <!-- Снимаем этот сбор на Стерильной -->
        <BinaryModifier TargetProperty="BonusPopulationDust" Operation="Subtraction" Left="$(DustbornDustBaseNormal)" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="./PlanetGameplayTypeMeager/PopulationExploitingPlanetWhileDepleting" TooltipHidden="true"/>
        <!-- Teeming: удвоение (ещё столько же сверху) -->
        <BinaryModifier TargetProperty="BonusPopulationDust" Operation="Addition" Left="$(DustbornDustBaseTeeming)" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="./PlanetGameplayTypeTeeming/PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
        <!-- Стерильные после награды 3-C "Скупая Мудрость": 2 базово + 1 за тип планеты -->
        <BinaryModifier TargetProperty="BonusPopulationDust" Operation="Addition" Left="$(DustbornDustBaseMeager)" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="./PlanetGameplayTypeMeager/PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="PopulationExploitingPlanetWhileDepleting" Type="PopulationExploitingPlanetWhileDepleting"/>

    <!-- КОНВЕРСИЯ ЕДЫ В ПЫЛЬ (v7 - механика открывается технологией Т1)
         Сам по себе трейт популяции НЕ даёт конверсию в пыль: она включается только
         технологией «Первый Голод» (TechnologyDustbornFoodToDust0, эра 1), которая
         вешает на каждую систему +25% излишка еды в SystemMoney.
         Здесь остаётся только:
           - свойство DustbornFoodToDustRatio (используется наградой 6-A "Погасить Источник");
           - DisableFoodConversion = 1: штатная конверсия еды в производство отключена
             (иначе еда снова пойдёт в промышленность, как было в v5). -->
    <SimulationDescriptor Name="ClassPopulationStarSystemModifiersTraitDustbornsFoodToDust" Type="ClassPopulationStarSystem">
        <Property Name="DustbornFoodToDustRatio" BaseValue="0" MinValue="0" MaxValue="1"/>

        <!-- Отключаем штатную конверсию еды в производство -->
        <Modifier TargetProperty="DisableFoodConversion" Operation="Force" Value="1"
                  Path="../ClassColonizedStarSystem" TooltipHidden="true"/>
    </SimulationDescriptor>

