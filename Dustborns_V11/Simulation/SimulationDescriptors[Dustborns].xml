        <Modifier TargetProperty="DustbornDustBaseTeeming" Operation="Addition" Value="4" Path="ClassEmpire/ClassColonizedStarSystem/ClassColonizedPlanet/ClassPopulation,ClassPopulationPlanetModifiersTraitDustbornsPrimary" TooltipHidden="false"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="PopulationCollectionBonusBezvolny10" Type="PopulationCollectionBonus">
