        <Modifier TargetProperty="BonusFromDepletion" Operation="Force" Value="0" Path="ClassColonizedPlanet/PopulationExploitingPlanetWhileDepleting" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="TemporaryEffectBezvolnyDustReward" Type="TemporaryEffect">
        <!-- Значение масштабируется веткой технологий "Пищеварение": 300/600/900/1200.
             Читается из свойства империи DustbornDigestionValue (держатель DustbornDigestionHolder). -->
        <Modifier TargetProperty="SystemMoney" Operation="Addition" Value="$(DustbornDigestionValue)" Path="../ClassEmpire" TooltipHidden="false" SearchValueFromPath="true"/>
        <!-- Запасной фикс, если чтение свойства не сработает - раскомментируй строку ниже и закомментируй верхнюю:
        <Modifier TargetProperty="SystemMoney" Operation="Addition" Value="300" TooltipHidden="false"/>
        -->
