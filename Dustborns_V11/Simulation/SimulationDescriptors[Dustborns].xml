    <!-- ============ СТАТУСЫ СБОРА: ПЫЛЕРОЖДЁННЫЕ / БЕЗВОЛЬНЫЕ / СЧИТАЮЩИЕ ОБОЛОЧКИ ============ -->
    <SimulationDescriptor Name="PopulationCollectionBonusDustborns20" Type="PopulationCollectionBonus">
        <Modifier TargetProperty="DustbornIceReduction" Operation="Addition" Value="0.05" Path="ClassEmpire/ClassColonizedStarSystem/ClassColonizedPlanet/ClassPopulation,ClassPopulationPlanetModifiersTraitDustbornsPrimary" TooltipHidden="false"/>
    </SimulationDescriptor>
    <SimulationDescriptor Name="PopulationCollectionBonusDustborns50" Type="PopulationCollectionBonus">
