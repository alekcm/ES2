        <Modifier TargetProperty="PopulationApproval" Operation="Subtraction" Value="5" Path="ClassEmpire/ClassColonizedStarSystem/ClassColonizedPlanet,PlanetDepletionMalus/ClassPopulation,ClassPopulationPlanetModifiersTraitBezvolnyScholarPrimary" TooltipHidden="true"/>
        <BinaryModifier TargetProperty="PopulationApproval" Operation="Addition" Left="-10" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="ClassEmpire/ClassColonizedStarSystem/ClassColonizedPlanet/ClassPopulation,ClassPopulationPlanetModifiersTraitBezvolnyScholarPrimary/../ClassColonizedPlanet/ClassPopulation,ClassPopulationPlanetAffinityDustbornsCount" TooltipHidden="false"/>
