    <LocalizationPair Name="%TechnologyDustbornFoodToDust3Title">Полный Распад</LocalizationPair>
    <LocalizationPair Name="%TechnologyDustbornFoodToDust3Description">Конверсия еды в Пыль: 75% -&gt; 100%.</LocalizationPair>

