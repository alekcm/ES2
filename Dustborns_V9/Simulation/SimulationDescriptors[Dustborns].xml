<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/Amplitude.Unity.Simulation.SimulationDescriptor.xsd">

    <SimulationDescriptor Name="AffinityDustborns" Type="Affinity"/>
    <SimulationDescriptor Name="AffinityMappingDustborns" Type="AffinityMapping"/>
    <SimulationDescriptor Name="AffinityBezvolny" Type="Affinity"/>
    <SimulationDescriptor Name="AffinityMappingBezvolny" Type="AffinityMapping"/>

    <SimulationDescriptor Name="ClassPopulationEmpireAffinityDustborns" Type="ClassPopulationEmpire">
        <Modifier TargetProperty="CanBeBoosted" Operation="Force" Value="0" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityDustborns" Type="ClassPopulationStarSystem">
        <Modifier TargetProperty="CannotMigrate" Operation="Force" Value="1" TooltipHidden="true"/>
        <Modifier TargetProperty="ShouldPopulationGrow" Operation="Force" Value="-1" TooltipHidden="true"/>
        <Modifier TargetProperty="PopulationWithGrowth" Operation="Subtraction" Value="$(PopulationCount)" Path="./ClassStarSystem" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationPlanetAffinityDustbornsCount" Type="ClassPopulationPlanet">
        <Modifier TargetProperty="PopulationCount" Operation="Addition" Value="$(PopulationCount)" Path="../ClassStarSystem/ClassPopulation,ClassPopulationStarSystemAffinityDustbornsCount" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityDustbornsCount" Type="ClassPopulationStarSystem">
        <Modifier TargetProperty="PopulationCount" Operation="Addition" Value="$(PopulationCount)" Path="./!ClassExploitedStarSystem/../ClassEmpire/ClassPopulation,ClassPopulationEmpireAffinityDustbornsCount" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationEmpireAffinityDustbornsCount" Type="ClassPopulationEmpire">
        <Modifier TargetProperty="NetPopulationScore" Operation="Multiplication" Value="$(PopulationGrowthScoreModifier)" Path="../ClassEmpire/ClassColonizedStarSystem/ClassPopulationStarSystemAffinityDustbornsCount" Priority="100" TooltipHidden="true"/>
    </SimulationDescriptor>

    <!-- ==========================================================================
         DUSTBORN PRIMARY
         База сбора пыли: 4 обычная / 8 Teeming / 0 Стерильная.
         Растёт от Каталога Миров (§0.1): +2 обычная, +4 Teeming за каждый уникальный
         истощённый тип планеты. Стерильные открываются наградой этапа 3-C.
         ========================================================================== -->
    <SimulationDescriptor Name="ClassPopulationPlanetModifiersTraitDustbornsPrimary" Type="ClassPopulationPlanet">
        <Property Name="BonusFromDepletion" BaseValue="1"/>

        <!-- Счётчик уникальных истощённых типов планет. Поднимается флагами EmpireCatalogPlanet* -->
        <Property Name="DustbornCatalogPlanets" BaseValue="0" MinValue="0"/>
        <!-- Флаг награды этапа 3-C "Скупая Мудрость": разрешает сбор со Стерильных -->
        <Property Name="DustbornMeagerUnlocked" BaseValue="0" MinValue="0" MaxValue="1"/>

        <!-- Итоговые ставки сбора -->
        <Property Name="DustbornDustBaseNormal" BaseValue="4" MinValue="0"/>
        <Property Name="DustbornDustBaseTeeming" BaseValue="4" MinValue="0"/>
        <Property Name="DustbornDustBaseMeager" BaseValue="0" MinValue="0"/>
        <BinaryModifier TargetProperty="DustbornDustBaseNormal"  Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(DustbornCatalogPlanets)" TooltipHidden="true"/>
        <BinaryModifier TargetProperty="DustbornDustBaseTeeming" Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(DustbornCatalogPlanets)" TooltipHidden="true"/>

        <!-- Истощение -->
        <Modifier TargetProperty="PlanetDepletionPerTurn" Operation="Addition" Value="1" Path="False/./ClassPlanet"/>
        <BinaryModifier TargetProperty="PlanetDepletionPerTurn" Operation="Addition" Left="1" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="./ClassPlanet" TooltipHidden="true"/>
        <Modifier TargetProperty="BonusFromDepletion" Operation="Force" Value="0" TooltipHidden="true" Priority="-1"/>

        <!-- Штраф промышленности: -10% за каждого Пылерождённого на планете -->
        <BinaryModifier TargetProperty="PlanetIndustry" Operation="Percent" Left="-0.1" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="./ClassPlanet" Priority="10" TooltipHidden="false"/>
        <BinaryModifier TargetProperty="NetPlanetIndustry" Operation="Percent" Left="-0.1" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="./ClassPlanet" Priority="10" TooltipHidden="true"/>

        <!-- Сбор пыли на не-Стерильной планете, только пока не истощена -->
        <BinaryModifier TargetProperty="BonusPopulationDust" Operation="Addition" Left="$(DustbornDustBaseNormal)" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
        <!-- Снимаем этот сбор на Стерильной -->
        <BinaryModifier TargetProperty="BonusPopulationDust" Operation="Subtraction" Left="$(DustbornDustBaseNormal)" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="./PlanetGameplayTypeMeager/PopulationExploitingPlanetWhileDepleting" TooltipHidden="true"/>
        <!-- Teeming: удвоение (ещё столько же сверху) -->
        <BinaryModifier TargetProperty="BonusPopulationDust" Operation="Addition" Left="$(DustbornDustBaseTeeming)" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="./PlanetGameplayTypeTeeming/PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
        <!-- Стерильные после награды 3-C "Скупая Мудрость": 2 базово + 1 за тип планеты -->
        <BinaryModifier TargetProperty="BonusPopulationDust" Operation="Addition" Left="$(DustbornDustBaseMeager)" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="./PlanetGameplayTypeMeager/PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="PopulationExploitingPlanetWhileDepleting" Type="PopulationExploitingPlanetWhileDepleting"/>

    <!-- КОНВЕРСИЯ ЕДЫ В ПЫЛЬ (v7 - механика открывается технологией Т1)
         Сам по себе трейт популяции НЕ даёт конверсию в пыль: она включается только
         технологией «Первый Голод» (TechnologyDustbornFoodToDust0, эра 1), которая
         вешает на каждую систему +25% излишка еды в SystemMoney.
         Здесь остаётся только:
           - свойство DustbornFoodToDustRatio (используется наградой 6-A "Погасить Источник");
           - DisableFoodConversion = 1: штатная конверсия еды в производство отключена
             (иначе еда снова пойдёт в промышленность, как было в v5). -->
    <SimulationDescriptor Name="ClassPopulationStarSystemModifiersTraitDustbornsFoodToDust" Type="ClassPopulationStarSystem">
        <Property Name="DustbornFoodToDustRatio" BaseValue="0" MinValue="0" MaxValue="1"/>

        <!-- Отключаем штатную конверсию еды в производство -->
        <Modifier TargetProperty="DisableFoodConversion" Operation="Force" Value="1"
                  Path="../ClassColonizedStarSystem" TooltipHidden="true"/>
    </SimulationDescriptor>

    <!-- Bezvolny -->
    <SimulationDescriptor Name="ClassPopulationEmpireAffinityBezvolny" Type="ClassPopulationEmpire">
        <Modifier TargetProperty="CanBeBoosted" Operation="Force" Value="0" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityBezvolny" Type="ClassPopulationStarSystem">
        <Modifier TargetProperty="CannotMigrate" Operation="Force" Value="0" TooltipHidden="true"/>
        <Modifier TargetProperty="ShouldPopulationGrow" Operation="Force" Value="-1" TooltipHidden="true"/>
        <Modifier TargetProperty="PopulationWithGrowth" Operation="Subtraction" Value="$(PopulationCount)" Path="./ClassStarSystem" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationPlanetAffinityBezvolnyCount" Type="ClassPopulationPlanet">
        <Modifier TargetProperty="PopulationCount" Operation="Addition" Value="$(PopulationCount)" Path="../ClassStarSystem/ClassPopulation,ClassPopulationStarSystemAffinityBezvolnyCount" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityBezvolnyCount" Type="ClassPopulationStarSystem">
        <Modifier TargetProperty="PopulationCount" Operation="Addition" Value="$(PopulationCount)" Path="./!ClassExploitedStarSystem/../ClassEmpire/ClassPopulation,ClassPopulationEmpireAffinityBezvolnyCount" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationEmpireAffinityBezvolnyCount" Type="ClassPopulationEmpire">
        <Modifier TargetProperty="NetPopulationScore" Operation="Multiplication" Value="$(PopulationGrowthScoreModifier)" Path="../ClassEmpire/ClassColonizedStarSystem/ClassPopulationStarSystemAffinityBezvolnyCount" Priority="100" TooltipHidden="true"/>
    </SimulationDescriptor>

    <!-- Bezvolny Primary: +3 промышленности (+6 на истощённой). Наука и влияние - как у обычного населения. -->
    <SimulationDescriptor Name="ClassPopulationPlanetModifiersTraitBezvolnyPrimary" Type="ClassPopulationPlanet">
        <Property Name="BonusFromDepletion" BaseValue="1"/>
        <Modifier TargetProperty="BonusFromDepletion" Operation="Force" Value="0" TooltipHidden="true" Priority="-1"/>
        <Modifier TargetProperty="BonusPopulationIndustry" Operation="Addition" Value="3" TooltipHidden="false"/>
        <BinaryModifier TargetProperty="BonusPopulationIndustry" Operation="Addition" Left="-3" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
        <Modifier TargetProperty="BonusPopulationIndustry" Operation="Addition" Value="3" Path="PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
        <!-- Наука и Влияние Безвольных больше НЕ режутся: обе блокировки не работали,
             и по решению дизайна Безвольные теперь производят науку и влияние как обычное население.
             Научная специализация вынесена в отдельную популяцию "Безвольный-Учёный" (квест §2.10). -->
        <Modifier TargetProperty="BonusPopulationDust" Operation="Force" Value="0" Priority="5" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="AffinityGameplayDustborns" Type="AffinityGameplay">
        <Modifier TargetProperty="HasAffinityCravers" Operation="Force" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
        <Modifier TargetProperty="HasAffinityCravers" Operation="Force" Value="1" Path="ClassEmpire/ClassColonizedStarSystem" TooltipHidden="true"/>
        <Modifier TargetProperty="ImprovementScrapValueModifier" Operation="Addition" Value="5.67" Path="ClassEmpire" TooltipHidden="false"/>
        <Modifier TargetProperty="CanSellImprovements" Operation="Force" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="AffinityGameplayBezvolny" Type="AffinityGameplay"/>

    <SimulationDescriptor Name="QueuedDescriptorIncreaseVirtualPopulationDustborns" Type="QueuedDescriptor">
        <Modifier TargetProperty="VirtualPopulation" Operation="Addition" Value="1"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="QueuedDescriptorDecreaseVirtualPopulationDustborns" Type="QueuedDescriptor">
        <Modifier TargetProperty="VirtualPopulation" Operation="Subtraction" Value="1"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="QueuedDescriptorIncreaseVirtualPopulationBezvolny" Type="QueuedDescriptor">
        <Modifier TargetProperty="VirtualPopulation" Operation="Addition" Value="1"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="StarSystemImprovementCreateMajorPopulationDustborns" Type="StarSystemImprovement"/>
    <SimulationDescriptor Name="StarSystemImprovementSellMajorPopulationDustborns" Type="StarSystemImprovement"/>
    <SimulationDescriptor Name="StarSystemImprovementConvertToBezvolny" Type="StarSystemImprovement"/>

    <!-- Убираем старые PlanetDepletionBonus/Neutral override - теперь логика через теги планеты -->
    <SimulationDescriptor Name="PlanetDepletionBonus" Type="PlanetDepletion">
        <Modifier TargetProperty="BonusFromDepletion" Operation="Addition" Value="1" Path="ClassColonizedPlanet/PopulationExploitingPlanetWhileDepleting" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="PlanetDepletionNeutral" Type="PlanetDepletion">
        <Modifier TargetProperty="BonusFromDepletion" Operation="Addition" Value="1" Path="ClassColonizedPlanet/PopulationExploitingPlanetWhileDepleting" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="PlanetDepletionMalus" Type="PlanetDepletion">
        <Property Name="DepletedPlanetCount" BaseValue="1"/>
        <Modifier TargetProperty="BonusFromDepletion" Operation="Force" Value="0" Path="ClassColonizedPlanet/PopulationExploitingPlanetWhileDepleting" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="TemporaryEffectBezvolnyDustReward" Type="TemporaryEffect">
        <!-- Значение масштабируется веткой технологий "Пищеварение": 300/600/900/1200.
             Читается из свойства империи DustbornDigestionValue (держатель DustbornDigestionHolder). -->
        <Modifier TargetProperty="SystemMoney" Operation="Addition" Value="$(DustbornDigestionValue)" Path="../ClassEmpire" TooltipHidden="false" SearchValueFromPath="true"/>
        <!-- Запасной фикс, если чтение свойства не сработает - раскомментируй строку ниже и закомментируй верхнюю:
        <Modifier TargetProperty="SystemMoney" Operation="Addition" Value="300" TooltipHidden="false"/>
        -->
    </SimulationDescriptor>

    <SimulationDescriptor Name="TemporaryEffectDustbornSellDustReward" Type="TemporaryEffect">
        <Modifier TargetProperty="SystemMoney" Operation="Addition" Value="250" TooltipHidden="false"/>
    </SimulationDescriptor>

    <!-- ============ 2.10 СЧИТАЮЩАЯ ОБОЛОЧКА ============ -->
    <SimulationDescriptor Name="AffinityBezvolnyScholar" Type="Affinity"/>

    <SimulationDescriptor Name="ClassPopulationEmpireAffinityBezvolnyScholar" Type="ClassPopulationEmpire">
        <Modifier TargetProperty="CanBeBoosted" Operation="Force" Value="0" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityBezvolnyScholar" Type="ClassPopulationStarSystem">
        <Modifier TargetProperty="CannotMigrate" Operation="Force" Value="0" TooltipHidden="true"/>
        <Modifier TargetProperty="ShouldPopulationGrow" Operation="Force" Value="-1" TooltipHidden="true"/>
        <Modifier TargetProperty="PopulationWithGrowth" Operation="Subtraction" Value="$(PopulationCount)" Path="./ClassStarSystem" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationPlanetAffinityBezvolnyScholarCount" Type="ClassPopulationPlanet">
        <Modifier TargetProperty="PopulationCount" Operation="Addition" Value="$(PopulationCount)" Path="../ClassStarSystem/ClassPopulation,ClassPopulationStarSystemAffinityBezvolnyScholarCount" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityBezvolnyScholarCount" Type="ClassPopulationStarSystem">
        <Modifier TargetProperty="PopulationCount" Operation="Addition" Value="$(PopulationCount)" Path="./!ClassExploitedStarSystem/../ClassEmpire/ClassPopulation,ClassPopulationEmpireAffinityBezvolnyScholarCount" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationEmpireAffinityBezvolnyScholarCount" Type="ClassPopulationEmpire">
        <Modifier TargetProperty="NetPopulationScore" Operation="Multiplication" Value="$(PopulationGrowthScoreModifier)" Path="../ClassEmpire/ClassColonizedStarSystem/ClassPopulationStarSystemAffinityBezvolnyScholarCount" Priority="100" TooltipHidden="true"/>
    </SimulationDescriptor>

    <!-- Всё как у Безвольного, плюс +2 науки за каждого Пылерождённого на ТОЙ ЖЕ планете.
         Оболочка сама по себе пустая - она считает только когда рядом есть пыль. -->
    <SimulationDescriptor Name="ClassPopulationPlanetModifiersTraitBezvolnyScholarPrimary" Type="ClassPopulationPlanet">
        <Property Name="BonusFromDepletion" BaseValue="1"/>
        <Modifier TargetProperty="BonusFromDepletion" Operation="Force" Value="0" TooltipHidden="true" Priority="-1"/>
        <Modifier TargetProperty="BonusPopulationIndustry" Operation="Addition" Value="3" TooltipHidden="false"/>
        <BinaryModifier TargetProperty="BonusPopulationIndustry" Operation="Addition" Left="-3" BinaryOperation="Multiplication" Right="$(BonusFromDepletion)" Path="PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
        <Modifier TargetProperty="BonusPopulationIndustry" Operation="Addition" Value="3" Path="PopulationExploitingPlanetWhileDepleting" TooltipHidden="false"/>
        <!-- Наука: +2 за каждого Пылерождённого на этой планете -->
        <BinaryModifier TargetProperty="BonusPopulationScience" Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(PopulationCount)" Path="../ClassColonizedPlanet/ClassPopulation,ClassPopulationPlanetAffinityDustbornsCount" TooltipHidden="false"/>
        <Modifier TargetProperty="BonusPopulationDust" Operation="Force" Value="0" Priority="5" TooltipHidden="true"/>
    </SimulationDescriptor>

    <!-- ============ 6-C КУРГАНОРОЖДЁННЫЙ ============ -->
    <SimulationDescriptor Name="AffinityBarrowborn" Type="Affinity"/>

    <SimulationDescriptor Name="ClassPopulationEmpireAffinityBarrowborn" Type="ClassPopulationEmpire">
        <Modifier TargetProperty="CanBeBoosted" Operation="Force" Value="1" TooltipHidden="true"/>
    </SimulationDescriptor>

    <!-- Ключевое отличие от Пылерождённых: население РАСТЁТ обычным образом за счёт еды -->
    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityBarrowborn" Type="ClassPopulationStarSystem">
        <Modifier TargetProperty="CannotMigrate" Operation="Force" Value="0" TooltipHidden="true"/>
        <Modifier TargetProperty="ShouldPopulationGrow" Operation="Force" Value="1" TooltipHidden="false"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationPlanetAffinityBarrowbornCount" Type="ClassPopulationPlanet">
        <Modifier TargetProperty="PopulationCount" Operation="Addition" Value="$(PopulationCount)" Path="../ClassStarSystem/ClassPopulation,ClassPopulationStarSystemAffinityBarrowbornCount" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityBarrowbornCount" Type="ClassPopulationStarSystem">
        <Modifier TargetProperty="PopulationCount" Operation="Addition" Value="$(PopulationCount)" Path="./!ClassExploitedStarSystem/../ClassEmpire/ClassPopulation,ClassPopulationEmpireAffinityBarrowbornCount" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationEmpireAffinityBarrowbornCount" Type="ClassPopulationEmpire">
        <Modifier TargetProperty="NetPopulationScore" Operation="Multiplication" Value="$(PopulationGrowthScoreModifier)" Path="../ClassEmpire/ClassColonizedStarSystem/ClassPopulationStarSystemAffinityBarrowbornCount" Priority="100" TooltipHidden="true"/>
    </SimulationDescriptor>

    <!-- Ультимативная универсальная форма: +6 пыли/науки/производства/еды, +2 единства, +5 счастья.
         Не истощает планеты и не имеет штрафа производства. -->
    <SimulationDescriptor Name="ClassPopulationPlanetModifiersTraitBarrowbornPrimary" Type="ClassPopulationPlanet">
        <Modifier TargetProperty="BonusPopulationDust" Operation="Addition" Value="6" TooltipHidden="false"/>
        <Modifier TargetProperty="BonusPopulationScience" Operation="Addition" Value="6" TooltipHidden="false"/>
        <Modifier TargetProperty="BonusPopulationIndustry" Operation="Addition" Value="6" TooltipHidden="false"/>
        <Modifier TargetProperty="BonusPopulationFood" Operation="Addition" Value="6" TooltipHidden="false"/>
        <Modifier TargetProperty="BonusPopulationEmpirePoint" Operation="Addition" Value="2" TooltipHidden="false"/>
        <Modifier TargetProperty="PopulationApproval" Operation="Addition" Value="5" TooltipHidden="false"/>
    </SimulationDescriptor>

</Datatable>
