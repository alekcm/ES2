<?xml version="1.0" encoding="utf-8"?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/PopulationCollectionBonusTrait.xsd">

  <!-- MajorHisshos -->
    <PopulationCollectionBonusTrait Name="PopulationCollectionBonusTraitMajorHisshos" Cost="0" CustomEquivalent="PopulationCollectionBonusTraitCustomFactionManpowerProductionCost" ShowInCustom="false">
        <CollectionBonus Threshold="10">
            <SimulationDescriptorReference Name="PopulationCollectionBonusMajorHisshos1"/>
            <SimulationDescriptorReference Name="PopulationCollectionBonusLevel1"/>
        </CollectionBonus>

        <CollectionBonus Threshold="20">
            <SimulationDescriptorReference Name="PopulationCollectionBonusMajorHisshos2"/>
            <SimulationDescriptorReference Name="PopulationCollectionBonusLevel2"/>
        </CollectionBonus>

        <CollectionBonus Threshold="50">
            <SimulationDescriptorReference Name="PopulationCollectionBonusMajorHisshos3"/>
            <SimulationDescriptorReference Name="PopulationCollectionBonusLevel3"/>
        </CollectionBonus>
    </PopulationCollectionBonusTrait>

    <!-- Minor of the Hisshos -->
    <PopulationCollectionBonusTrait Name="PopulationCollectionBonusTraitIllo" Cost="0" ShowInCustom="false">
        <CollectionBonus Threshold="5">
            <SimulationDescriptorReference Name="PopulationCollectionBonusIllo1"/>
            <SimulationDescriptorReference Name="PopulationCollectionBonusLevel1"/>
        </CollectionBonus>

        <CollectionBonus Threshold="10">
            <SimulationDescriptorReference Name="PopulationCollectionBonusIllo2"/>
            <SimulationDescriptorReference Name="PopulationCollectionBonusLevel2"/>
        </CollectionBonus>

        <CollectionBonus Threshold="20">
            <SimulationDescriptorReference Name="PopulationCollectionBonusLevel3"/>
            <SimulationDescriptorReference Name="PopulationCollectionBonusIllo3"/>
        </CollectionBonus>
    </PopulationCollectionBonusTrait>

    <PopulationCollectionBonusTrait Name="PopulationCollectionBonusTraitCustomFactionManpowerProductionCost" Cost="10" ShowInCustom="true">
        <CollectionBonus Threshold="10">
            <SimulationDescriptorReference Name="PopulationCollectionBonusMajorHisshos1"/>
            <SimulationDescriptorReference Name="PopulationCollectionBonusLevel1"/>
        </CollectionBonus>

        <CollectionBonus Threshold="20">
            <SimulationDescriptorReference Name="PopulationCollectionBonusCustomFactionManpowerProductionCost2"/>
            <SimulationDescriptorReference Name="PopulationCollectionBonusLevel2"/>
        </CollectionBonus>

        <CollectionBonus Threshold="50">
            <SimulationDescriptorReference Name="PopulationCollectionBonusMajorHisshos3"/>
            <SimulationDescriptorReference Name="PopulationCollectionBonusLevel3"/>
        </CollectionBonus>
    </PopulationCollectionBonusTrait>

</Datatable>