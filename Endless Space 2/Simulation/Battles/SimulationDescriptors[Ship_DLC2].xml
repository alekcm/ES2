<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../../Schemas/Amplitude.Unity.Simulation.SimulationDescriptor.xsd">

    <SimulationDescriptor Name="ShipFactionMajorHisshos"    Type="ShipFaction"/>
    
    <SimulationDescriptor Name="ShipSizeJuggernaut"         Type="ShipSize">
        <Property Name="MiningProbeDepositValueMultiplier" BaseValue="0" MinValue="0" Composition="Maximum"/> <!-- Property only used by GUI: gameplay uses only the Fleet's property. -->
        <Property Name="MiningProbePlanetStatsMultiplier"  BaseValue="0" MinValue="0" Composition="Maximum"/> <!-- Property only used by GUI: gameplay uses only the Fleet's property. -->
        
        <Modifier TargetProperty="VisionRange"                      Operation="Addition"    Value="1"       Path="ClassShip"/>
        <Modifier TargetProperty="CommandPoints"                    Operation="Addition"    Value="10"      Path="ClassShip"/>
        <Modifier TargetProperty="ShieldRadius"                     Operation="Addition"    Value="2.5"     Path="ClassShip"/>
        <Modifier TargetProperty="ScrapPriority"                    Operation="Subtraction" Value="2"       Path="ClassShip"/>
        <Modifier TargetProperty="VisualImportanceScore"            Operation="Addition"    Value="1000"    Path="ClassShip"/>
        <Modifier TargetProperty="HullWeakness"                     Operation="Addition"    Value="500"     Path="ClassShip"/>
        <Modifier TargetProperty="SizeDamageMultiplierForSquadron"  Operation="Addition"    Value="1"       Path="ClassShip" TooltipHidden="true"/>

        <Modifier TargetProperty="JuggernautCount"                  Operation="Addition"    Value="1"       Path="../ClassEmpire" TooltipHidden="true"/>
        <Modifier TargetProperty="MaximumHonorZoneRadius"           Operation="Addition"    Value="20"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ShipRoleJuggernaut"         Type="ShipRole"/>
    
    <SimulationDescriptor Name="ShipRoleBattleship"         Type="ShipRole">
        <Property Name="TurnsBeforeIonWaveIsAvailable" IsSealed="true"/>
        <Property Name="NetTurnsBeforeIonWaveIsAvailable" BaseValue="-1" MinValue="Negative"/>
        <Modifier TargetProperty="BattleshipCount" Operation="Addition" Value="1" Path="../ClassEmpire" TooltipHidden="true"/>
        <Modifier TargetProperty="AntiVisionStrengthForModule" Operation="Force"     Value="0" Path="../ClassGarrisonFleet"  TooltipHidden="true" Priority="0"/>
    </SimulationDescriptor>
    
    <SimulationDescriptor Name="ShipRoleObliterator"         Type="ShipRole">
        <Property Name="TurnsSinceObliteratorShot"              BaseValue="0" IsSealed="true"/>
        <Property Name="NetTurnsSinceObliteratorShot"           BaseValue="1"/>
        
        <Property Name="BaseTurnsBeforeFreeObliteratorShot"     BaseValue="40"/>
        <Property Name="BonusTurnsBeforeFreeObliteratorShot"    BaseValue="0" MinValue="Negative"/>
        <Property Name="TurnsBeforeNextFreeObliteratorShot"     BaseValue="0"/>
        <Property Name="ObliteratorShotCost"                    BaseValue="0"/>

        <Property Name="ObliteratorShotsThisTurn"               BaseValue="0" IsSealed="true"/>
        <Property Name="NetObliteratorShotsThisTurn"            BaseValue="-100" MinValue="Negative"/>
        <Property Name="ExcessiveObliteratorShotsThisTurn"      BaseValue="-1" MinValue="0"/>

        <!-- Turns before next free shot = turns for free shot - turns since last shot. That's pretty easy. -->
        <BinaryModifier TargetProperty="TurnsBeforeNextFreeObliteratorShot" Operation="Addition" Left="$(BaseTurnsBeforeFreeObliteratorShot)" BinaryOperation="Subtraction" Right="$(TurnsSinceObliteratorShot)"/>
        <Modifier TargetProperty="TurnsBeforeNextFreeObliteratorShot" Operation="Addition" Value="$(BonusTurnsBeforeFreeObliteratorShot)" />
        
        <!-- Cost = turns before free Obliterator shot x baseCost x multiplier from shots this turn. -->
        <BinaryModifier TargetProperty="ObliteratorShotCost" Operation="Addition" Left="$(TurnsBeforeNextFreeObliteratorShot)" BinaryOperation="Multiplication" Right="12"/>
        <Modifier TargetProperty="ObliteratorShotCost" Operation="Percent" Value="$(ExcessiveObliteratorShotsThisTurn)"/>

        <Modifier TargetProperty="ExcessiveObliteratorShotsThisTurn" Operation="Addition" Value="$(ObliteratorShotsThisTurn)"/>

        <Modifier TargetProperty="ObliteratorCount"   Operation="Addition"  Value="1" Path="../ClassEmpire"         TooltipHidden="true"/>
        <Modifier TargetProperty="AntiVisionStrengthForModule" Operation="Force"     Value="0" Path="../ClassGarrisonFleet"  TooltipHidden="true" Priority="0"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ShipFactionJuggernauts"     Type="ShipFaction"/>
    <SimulationDescriptor Name="UseEmpireAffinityForUnitSpawn"     Type="UseEmpireAffinityForUnitSpawn"/>
    <SimulationDescriptor Name="IgnoreAsObstacle"     Type="IgnoreAsObstacle"/>

    <SimulationDescriptor Name="ShipMustBeAlone"            Type="ShipMustBeAlone"/>
    <SimulationDescriptor Name="OnlyOneOfRolePerFleet"      Type="OnlyOneOfRolePerFleet"/>
    <SimulationDescriptor Name="OnlyOneOfRolePerEncounterGroup"      Type="OnlyOneOfRolePerEncounterGroup"/>

</Datatable>