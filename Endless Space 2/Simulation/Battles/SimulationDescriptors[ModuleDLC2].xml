    <!-- Bonus science, dust & influence (on any node) -->
    <Modifier TargetProperty="NetEmpireMoneyOnSpecialNodes"         Operation="Addition"    Value="$(NetEmpireMoneyOnSpecialNodes)"         Path="../ClassGarrisonFleet,FleetOrbitingSpecialNode"/>
