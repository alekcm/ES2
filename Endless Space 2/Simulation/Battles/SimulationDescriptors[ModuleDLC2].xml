    <Property Name="NetStrategic4FromSpecialNodes"/>
    <Property Name="NetStrategic5FromSpecialNodes"/>
    <Property Name="NetStrategic6FromSpecialNodes"/>

    <Property Name="SpecialNodeEffectMultiplier"/>

    <!-- "I receive bonuses here". -->
