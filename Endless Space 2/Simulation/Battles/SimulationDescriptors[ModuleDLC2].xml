    <Modifier TargetProperty="NetStrategic2FromSpecialNodes"        Operation="Addition"        Value="$(NetStrategic2FromSpecialNodes)"            Path="../ClassGarrisonFleet,FleetOrbitingSpecialNodeBlackHole"/>
