<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/Amplitude.Unity.Simulation.SimulationDescriptor.xsd">

  
  
    <SimulationDescriptor Name="FactionTraitMinorMindOverBody" Type="FactionTraitMinor">
        <Modifier TargetProperty="SystemGrowth" Operation="Percent" Value="-0.1" SearchValueFromPath="true" Path="ClassEmpire/ClassColonizedStarSystem" TooltipHidden="true" />
        <BinaryModifier TargetProperty="SystemResearch"   Operation="Addition"    Left="0.1"   BinaryOperation="Multiplication" Right="$(SystemGrowth)" SearchValueFromPath="true"  Path="ClassEmpire/ClassColonizedStarSystem" TooltipOverride="%FactionTraitMinorMindOverBodyTooltipEffects"/>
        <Modifier TargetProperty="MinorTraitsAssimilated"                 Operation="Addition" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="FactionTraitMinorMineralStrutures" Type="FactionTraitMinor">
        <BinaryModifier TargetProperty="SystemMoneyUpkeep"   Operation="Percent"    Left="-0.2"   BinaryOperation="Multiplication" Right="$(OwnedStrategicDeposits)" SearchValueFromPath="true"  Path="ClassEmpire/ClassColonizedStarSystem" TooltipOverride="%FactionTraitMinorMineralStruturesTooltipEffects" />
        <Modifier TargetProperty="MinorTraitsAssimilated"                 Operation="Addition" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
    </SimulationDescriptor>


    <SimulationDescriptor Name="FactionTraitMinorHarmony" Type="FactionTraitMinor"/>
    
</Datatable>