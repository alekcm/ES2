  <!-- AWAKEN SYSTEM -->
  <StarSystemAwakenImprovementDefinition Name="StarSystemAwakenImprovement" SubCategory="SubCategoryAwaken">
    <Tags>NoBuyout</Tags>
    <QueuedSimulationDescriptorReference Name="StarSystemAwakenImprovementQueued"/>

    <CustomCost ResourceName="SystemTurnBased">1</CustomCost>

    <PathPrerequisite Flags="Prerequisite,Discard">ColonizedStarSystemStateColony</PathPrerequisite>
    <PathPrerequisite Flags="Prerequisite,Discard">../ClassEmpire,FactionTraitSlumberingRuins</PathPrerequisite>
    <!-- Ruins System But not yet awoken -->
    <PathPrerequisite Flags="Prerequisite,Discard">ClassStarSystem,SlumberingRuins,!AwokenSlumberingRuins</PathPrerequisite>

    <TemporaryEffect>SlumberingRuinsBonusEffect</TemporaryEffect>

    <!-- Modders, ConstructibleCommand's only work in StarSystemAwakenImprovementDefinition's However this is the unique aspect of them (so you can use them for anything you want) P.S I know the plural should not be 's it's to stop anyone copying an extra s-->
    <ConstructibleCommand Command="GivePopulation"      Arguments="Major,1"/><!-- Would be e.g. "AffinityTemplars" if you wanted to specify a pop type, Game will throw an error on completion if not a Valid Affinty or "Major"-->
    <ConstructibleCommand Command="BuildImprovement"    Arguments="StarSystemImprovementStartingFoodIndustry"/><!-- Technically searchs through all Constructible elements, but will almost certainly fail with any non-StarSystemImprovementDefinition as it casts to such -->
    <ConstructibleCommand Command="BuildImprovement"    Arguments="StarSystemImprovementStartingDustScience"/><!-- "ImprovementName, True" Will Allow Duplicates of it (Without/By Default Will not build improvment if it already exsists, PreReqs are ignored for this) -->
    <ConstructibleCommand Command="BuildImprovement"    Arguments="StarSystemImprovementDefense1Templars"/>
    <ConstructibleCommand Command="AddNodeDescriptor"   Arguments="AwokenSlumberingRuins"/><!-- Applied to the Node --><!-- This is used for the System Contextual Icon (It's much more efficient to check) -->
    <ConstructibleCommand Command="AddColonyDescriptor" Arguments="AwokenSlumberingRuins"/><!-- Applied to the Colony -->

    <!--<Resource Name="EmpireMoney">300</Resource>-->
    <Relics>3</Relics>

  </StarSystemAwakenImprovementDefinition>

