<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/Amplitude.Unity.Simulation.SimulationDescriptor.xsd">

    <SimulationDescriptor Name="ClassPopulationEmpireAffinityUmbralChoir" Type="ClassPopulationEmpire"/>
    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityUmbralChoir" Type="ClassPopulationStarSystem"/>
    <SimulationDescriptor Name="ClassPopulationAssimilatedEmpireAffinityUmbralChoir" Type="ClassPopulationAssimilated">
        <Modifier		TargetProperty="PopulationsAssimilated"			Operation="Addition"		Value="1"	Path="../ClassEmpire" TooltipHidden="true"/>
    </SimulationDescriptor>

    <SimulationDescriptor Name="ClassPopulationEmpireAffinityMinorHacking" Type="ClassPopulationEmpire"/>
    <SimulationDescriptor Name="ClassPopulationStarSystemAffinityMinorHacking" Type="ClassPopulationStarSystem"/>
    <SimulationDescriptor Name="ClassPopulationAssimilatedEmpireAffinityMinorHacking" Type="ClassPopulationAssimilated">
        <Modifier		TargetProperty="PopulationsAssimilated"			Operation="Addition"		Value="1"	Path="../ClassEmpire" TooltipHidden="true"/>
    </SimulationDescriptor>


    <!-- Super population stuff. -->
    <SimulationDescriptor Name="ClassPopulationEmpireSuperPopulation"   Type="ClassPopulationEmpire"/>
    
    <SimulationDescriptor Name="ClassPopulationStarSystemSuperPopulation"   Type="ClassPopulationStarSystem">
        <Modifier TargetProperty="SuperPopulationCount"         Operation="Addition"    Value="$(PopulationCount)"  Path="./ClassColonizedStarSystem" TooltipHidden="true"/>
        <Modifier TargetProperty="ShouldPopulationIncrease"     Operation="Force"       Value="0" TooltipHidden="true"/>
        <Modifier TargetProperty="PopulationWithDoubleUpkeep"   Operation="Addition"    Value="$(PopulationCount)"  Path="../ClassColonizedStarSystem"  TooltipHidden="true"/>
    </SimulationDescriptor>
    
    <SimulationDescriptor Name="ClassPopulationPlanetSuperPopulation"   Type="ClassPopulationPlanet">
        <Modifier TargetProperty="SuperPopulationCount"                                 Operation="Addition"    Value="$(PopulationCount)"  Path="./ClassColonizedPlanet" TooltipHidden="true"/>
        <Modifier TargetProperty="BonusPopulationProcessingPowerFromSuperPopulation"    Operation="Addition"    Value="2"/>

        <!-- Fake descriptor for GUI -->
        <Modifier   TargetProperty="EmpireMoney"            Operation="Addition"    Value="1" TooltipOverride="%ClassPopulationPlanetSuperPopulationFIDSIEffectOverride"/>
        <Modifier   TargetProperty="PopulationIndustry"     Operation="Addition"    Value="$(RawPopulationIndustry)"   Priority="-3" TooltipHidden="true" />
        <Modifier   TargetProperty="PopulationDust"         Operation="Addition"    Value="$(RawPopulationDust)"       Priority="-3" TooltipHidden="true" />
        <Modifier   TargetProperty="PopulationScience"      Operation="Addition"    Value="$(RawPopulationScience)"    Priority="-3" TooltipHidden="true" />
        <Modifier   TargetProperty="PopulationPrestige"     Operation="Addition"    Value="$(RawPopulationPrestige)"   Priority="-3" TooltipHidden="true" />
        <Modifier   TargetProperty="PopulationFood"         Operation="Addition"    Value="$(RawPopulationFood)"       Priority="-3" TooltipHidden="true" />
    </SimulationDescriptor>

</Datatable>