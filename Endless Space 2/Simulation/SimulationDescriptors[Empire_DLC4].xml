    <Modifier       TargetProperty="NetAcademyStress"                 Operation="Addition" Value="2"    Path="AcademyFactionDifficultyHard"  />
    <Modifier       TargetProperty="NetAcademyStress"                 Operation="Addition" Value="2.5"    Path="AcademyFactionDifficultyEndless"  />

    <Modifier       TargetProperty="ShipMoneyDistributionFactor"            Operation="Addition" Value="0.55"/>
    <Modifier       TargetProperty="ImprovementMoneyDistributionFactor"     Operation="Addition" Value="0.45"/>

    <BinaryModifier TargetProperty="NetAcademyEmpireMoney"        Operation="Addition" Left="90" BinaryOperation="Multiplication" Right="$(ColonizedStarSystemStateColonyCount)"/>

