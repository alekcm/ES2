    <Modifier       TargetProperty="NetAcademyStress"                 Operation="Addition" Value="1"    Path="AcademyFactionDifficultyNormal"/>
    <Modifier       TargetProperty="NetAcademyStress"                 Operation="Addition" Value="2"    Path="AcademyFactionDifficultyHard"  />
    <Modifier       TargetProperty="NetAcademyStress"                 Operation="Addition" Value="2.5"    Path="AcademyFactionDifficultyEndless"  />

    <Modifier       TargetProperty="ShipMoneyDistributionFactor"            Operation="Addition" Value="0.45"/>
    <Modifier       TargetProperty="ImprovementMoneyDistributionFactor"     Operation="Addition" Value="0.55"/>

    <BinaryModifier TargetProperty="NetAcademyEmpireMoney"        Operation="Addition" Left="70" BinaryOperation="Multiplication" Right="$(ColonizedStarSystemStateColonyCount)"/>

    <BinaryModifier TargetProperty="NetAcademyEmpireShipMoney"        Operation="Force" Left="$(NetAcademyEmpireMoney)" BinaryOperation="Multiplication" Right="$(ShipMoneyDistributionFactor)"/>
    <BinaryModifier TargetProperty="NetAcademyEmpireImprovementMoney" Operation="Force" Left="$(NetAcademyEmpireMoney)" BinaryOperation="Multiplication" Right="$(ImprovementMoneyDistributionFactor)"/>
    <BinaryModifier TargetProperty="NetAcademyEmpireDiplomacyMoney"   Operation="Force" Left="$(NetAcademyEmpireMoney)" BinaryOperation="Multiplication" Right="$(DiplomacyMoneyDistributionFactor)"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="AcademyResourceDistributionMidGame" Type="AcademyResourceDistribution">
    <Modifier       TargetProperty="NetAcademyStress"                 Operation="Addition" Value="0.5"  Path="AcademyFactionDifficultyEasy"/>
    <Modifier       TargetProperty="NetAcademyStress"                 Operation="Addition" Value="1"    Path="AcademyFactionDifficultyNormal"/>
    <Modifier       TargetProperty="NetAcademyStress"                 Operation="Addition" Value="2"    Path="AcademyFactionDifficultyHard"  />
    <Modifier       TargetProperty="NetAcademyStress"                 Operation="Addition" Value="2.5"    Path="AcademyFactionDifficultyEndless"  />

    <Modifier       TargetProperty="ShipMoneyDistributionFactor"            Operation="Addition" Value="0.5"/>
    <Modifier       TargetProperty="ImprovementMoneyDistributionFactor"     Operation="Addition" Value="0.5"/>

    <BinaryModifier TargetProperty="NetAcademyEmpireMoney"        Operation="Addition" Left="80" BinaryOperation="Multiplication" Right="$(ColonizedStarSystemStateColonyCount)"/>

    <BinaryModifier TargetProperty="NetAcademyEmpireShipMoney"        Operation="Force" Left="$(NetAcademyEmpireMoney)" BinaryOperation="Multiplication" Right="$(ShipMoneyDistributionFactor)"/>
    <BinaryModifier TargetProperty="NetAcademyEmpireImprovementMoney" Operation="Force" Left="$(NetAcademyEmpireMoney)" BinaryOperation="Multiplication" Right="$(ImprovementMoneyDistributionFactor)"/>
    <BinaryModifier TargetProperty="NetAcademyEmpireDiplomacyMoney"   Operation="Force" Left="$(NetAcademyEmpireMoney)" BinaryOperation="Multiplication" Right="$(DiplomacyMoneyDistributionFactor)"/>
