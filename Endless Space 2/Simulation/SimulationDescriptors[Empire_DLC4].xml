  <!-- Academy Reparations Simulation -->
  <SimulationDescriptor Name="Reparations" Type="Reparations">
    <Property Name="ReparationPoints" 			          BaseValue="0" IsSealed="true"/>
    <Property Name="ReparationAnger" 			            BaseValue="0" IsSealed="true"/>
    <Property Name="ReparationAngerDecayPerTurn" 			BaseValue="1"/>

    <Modifier TargetProperty="ReparationAngerDecayPerTurn" Operation="Multiplication" Value="$(GameSpeedMultiplier)"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="MajorRelationWithAcademyWar" Type="MajorRelationWithAcademy">
  </SimulationDescriptor>

  <SimulationDescriptor Name="MajorRelationWithAcademyHostile" Type="MajorRelationWithAcademy">
  </SimulationDescriptor>

  <SimulationDescriptor Name="MajorRelationWithAcademyNeutral" Type="MajorRelationWithAcademy">
  </SimulationDescriptor>

  <SimulationDescriptor Name="MajorRelationWithAcademyFriendly" Type="MajorRelationWithAcademy">
  </SimulationDescriptor>

  <SimulationDescriptor Name="MajorRelationWithAcademyAlly" Type="MajorRelationWithAcademy">
  </SimulationDescriptor>

  <!-- Academy ground combat plans -->
  <!-- Infantry has base weight of 10 -->
  <SimulationDescriptor Name="AcademyTroopDistributionInactive" Type="AcademyTroopDistribution">
  </SimulationDescriptor>

  <SimulationDescriptor Name="AcademyTroopDistributionPassive" Type="AcademyTroopDistribution">
    <Modifier TargetProperty="TankManpowerWeight"     Operation="Addition" Value="10"/>

    <Modifier TargetProperty="TankManpowerUnlocked"   Operation="Addition" Value="1"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="AcademyTroopDistributionRoaming" Type="AcademyTroopDistribution">
    <Modifier TargetProperty="InfantryManpowerWeight" Operation="Addition" Value="20"/>
    <Modifier TargetProperty="TankManpowerWeight"     Operation="Addition" Value="70"/>

    <Modifier TargetProperty="TankManpowerUnlocked"   Operation="Addition" Value="1"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="AcademyTroopDistributionAggressive" Type="AcademyTroopDistribution">
    <Modifier TargetProperty="InfantryManpowerWeight" Operation="Addition" Value="20"/>
    <Modifier TargetProperty="TankManpowerWeight"     Operation="Addition" Value="40"/>
    <Modifier TargetProperty="PlaneManpowerWeight"    Operation="Addition" Value="40"/>

    <Modifier TargetProperty="TankManpowerUnlocked"   Operation="Addition" Value="1"/>
    <Modifier TargetProperty="PlaneManpowerUnlocked"  Operation="Addition" Value="1"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="AcademyTroopDistributionDeveloping" Type="AcademyTroopDistribution">
    <Modifier TargetProperty="InfantryManpowerWeight" Operation="Addition" Value="20"/>
    <Modifier TargetProperty="TankManpowerWeight"     Operation="Addition" Value="40"/>
    <Modifier TargetProperty="PlaneManpowerWeight"    Operation="Addition" Value="40"/>

    <Modifier TargetProperty="TroopDamageBonuses"     Operation="Addition" Value="0.25"/>
    <Modifier TargetProperty="TroopHealthBonuses"     Operation="Addition" Value="0.25"/>

    <Modifier TargetProperty="TankManpowerUnlocked"   Operation="Addition" Value="1"/>
    <Modifier TargetProperty="PlaneManpowerUnlocked"  Operation="Addition" Value="1"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="AcademyTroopDistributionMidGame" Type="AcademyTroopDistribution">
    <Modifier TargetProperty="TankManpowerWeight"     Operation="Addition" Value="10"/>
    <Modifier TargetProperty="PlaneManpowerWeight"    Operation="Addition" Value="10"/>

    <Modifier TargetProperty="TroopDamageBonuses"     Operation="Addition" Value="0.5"/>
    <Modifier TargetProperty="TroopHealthBonuses"     Operation="Addition" Value="0.5"/>

    <Modifier TargetProperty="TankManpowerUnlocked"   Operation="Addition" Value="1"/>
    <Modifier TargetProperty="PlaneManpowerUnlocked"  Operation="Addition" Value="1"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="AcademyTroopDistributionLateGame" Type="AcademyTroopDistribution">
    <Modifier TargetProperty="TankManpowerWeight"     Operation="Addition" Value="10"/>
    <Modifier TargetProperty="PlaneManpowerWeight"    Operation="Addition" Value="10"/>

    <Modifier TargetProperty="TroopDamageBonuses"     Operation="Addition" Value="0.5"/>
    <Modifier TargetProperty="TroopHealthBonuses"     Operation="Addition" Value="0.5"/>
    <Modifier TargetProperty="ManpowerCostReduction"  Operation="Percent" Value="-0.15"/>

    <Modifier TargetProperty="TankManpowerUnlocked"   Operation="Addition" Value="1"/>
    <Modifier TargetProperty="PlaneManpowerUnlocked"  Operation="Addition" Value="1"/>
  </SimulationDescriptor>
</Datatable>