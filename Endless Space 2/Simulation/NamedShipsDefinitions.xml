  <NamedShipsDefinition Name="GrandAdmiral" >
    <NamedShip AcademyRoleDescriptorName="AcademyRoleGrandAdmiral" ShipDesignDefinitionName="NameShipGrandAdmiral"/>
    <CustomCost Instant="true" ResourceName="EmpireMoney">(Property(Empire, @ClassEmpire, DustInflation) * (0.2 *  Property(Ship, @ClassShip, MaximumHealth)) / 10.0)</CustomCost>
    <CustomScrapSellValue Instant="true" ResourceName="EmpireMoney">(Property(Empire, @ClassEmpire, DustInflation) * (0.2 *  Property(Ship, @ClassShip, MaximumHealth)) / 10.0) * 0.5</CustomScrapSellValue>
   </NamedShipsDefinition>

