<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/Amplitude.Unity.Simulation.SimulationDescriptor.xsd">

  <!--================-->
  <!-- ClassDiplomacy -->
  <!--================-->

  <SimulationDescriptor Name="ClassDiplomacy" Type="ClassDiplomacy">

    <!-- BasePressure receives only the score of the empire, for each empire -->
    <Property Name="BasePressure"               MinValue="0"/>
    <Property Name="BasePressureMultiplier"     MinValue="Negative" BaseValue="1"/>

    <!-- Traitors-related properties. -->
    <Property Name="MoneyRatioLostFromTraitors"         Composition="Sum" MinValue="0" MaxValue="1"/>
    <Property Name="StrategicRatioLostFromTraitors"     Composition="Sum" MinValue="0" MaxValue="1"/>
    <Property Name="LuxuryRatioLostFromTraitors"        Composition="Sum" MinValue="0" MaxValue="1"/>

    <Property Name="BaseMoneyRatioLostFromTraitors"     Composition="Sum" MinValue="1"/>
    <Property Name="BaseStrategicRatioLostFromTraitors" Composition="Sum" MinValue="1"/>
    <Property Name="BaseLuxuryRatioLostFromTraitors"    Composition="Sum" MinValue="1"/>

    <Property Name="NetEmpireMoneyGainedFromTraitors"   IsSealed="true"/>
    <Property Name="NetStrategic1GainedFromTraitors"    IsSealed="true"/>
    <Property Name="NetStrategic2GainedFromTraitors"    IsSealed="true"/>
    <Property Name="NetStrategic3GainedFromTraitors"    IsSealed="true"/>
    <Property Name="NetStrategic4GainedFromTraitors"    IsSealed="true"/>
    <Property Name="NetStrategic5GainedFromTraitors"    IsSealed="true"/>
    <Property Name="NetStrategic6GainedFromTraitors"    IsSealed="true"/>
    <Property Name="NetLuxury1GainedFromTraitors"       IsSealed="true"/>
    <Property Name="NetLuxury2GainedFromTraitors"       IsSealed="true"/>
    <Property Name="NetLuxury3GainedFromTraitors"       IsSealed="true"/>
    <Property Name="NetLuxury4GainedFromTraitors"       IsSealed="true"/>
    <Property Name="NetLuxury5GainedFromTraitors"       IsSealed="true"/>
    <Property Name="NetLuxury6GainedFromTraitors"       IsSealed="true"/>
    <Property Name="NetLuxury7GainedFromTraitors"       IsSealed="true"/>
    <Property Name="NetLuxury8GainedFromTraitors"       IsSealed="true"/>
    <Property Name="NetLuxury9GainedFromTraitors"       IsSealed="true"/>
    <Property Name="NetLuxury10GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury11GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury12GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury13GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury14GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury15GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury16GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury17GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury18GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury19GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury20GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury21GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury22GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury23GainedFromTraitors"      IsSealed="true"/>
    <Property Name="NetLuxury24GainedFromTraitors"      IsSealed="true"/>
    <Property Name="TraitorGainsMultiplier"             BaseValue="1" />

    <!-- Modifiers -->
    <Modifier TargetProperty="MyBasePressure"               Operation="Addition"        Value="$(BasePressure)"                 Path="ClassDiplomacy/ClassDiplomaticEmpire" />
    <Modifier TargetProperty="MyBasePressureMultiplier"     Operation="Multiplication"  Value="$(BasePressureMultiplier)"       Path="ClassDiplomacy/ClassDiplomaticEmpire" />

    <Modifier TargetProperty="MoneyRatioLostFromTraitors"       Operation="Division" Value="$(BaseMoneyRatioLostFromTraitors)" Path="ClassDiplomacy/ClassDiplomaticEmpire"/>
    <Modifier TargetProperty="StrategicRatioLostFromTraitors"   Operation="Division" Value="$(BaseStrategicRatioLostFromTraitors)" Path="ClassDiplomacy/ClassDiplomaticEmpire"/>
    <Modifier TargetProperty="LuxuryRatioLostFromTraitors"      Operation="Division" Value="$(BaseLuxuryRatioLostFromTraitors)" Path="ClassDiplomacy/ClassDiplomaticEmpire"/>

    <!-- Losses -->
    <Modifier       TargetProperty="MoneyRatioLostFromTraitors" Operation="Subtraction" Value="$(MoneyRatioLostFromTraitors)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic1"  Operation="Percent" Left="$(StrategicRatioLostFromTraitors)"    BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic2"  Operation="Percent" Left="$(StrategicRatioLostFromTraitors)"    BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic3"  Operation="Percent" Left="$(StrategicRatioLostFromTraitors)"    BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic4"  Operation="Percent" Left="$(StrategicRatioLostFromTraitors)"    BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic5"  Operation="Percent" Left="$(StrategicRatioLostFromTraitors)"    BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic6"  Operation="Percent" Left="$(StrategicRatioLostFromTraitors)"    BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury1"     Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury2"     Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury3"     Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury4"     Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury5"     Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury6"     Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury7"     Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury8"     Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury9"     Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury10"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury11"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury12"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury13"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury14"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury15"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury16"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury17"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury18"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury19"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury20"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury21"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury22"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury23"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury24"    Operation="Percent" Left="$(LuxuryRatioLostFromTraitors)"       BinaryOperation="Multiplication" Right="-1" Path="./ClassEmpire"/>

    <!-- Gains -->
    <BinaryModifier TargetProperty="EmpireMoneyGainedFromTraitors"  Operation="Addition" Left="$(NetEmpireMoneyGainedFromTraitors)" BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic1"                  Operation="Addition" Left="$(NetStrategic1GainedFromTraitors)"  BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic2"                  Operation="Addition" Left="$(NetStrategic2GainedFromTraitors)"  BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic3"                  Operation="Addition" Left="$(NetStrategic3GainedFromTraitors)"  BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic4"                  Operation="Addition" Left="$(NetStrategic4GainedFromTraitors)"  BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic5"                  Operation="Addition" Left="$(NetStrategic5GainedFromTraitors)"  BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetStrategic6"                  Operation="Addition" Left="$(NetStrategic6GainedFromTraitors)"  BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury1"                     Operation="Addition" Left="$(NetLuxury1GainedFromTraitors)"     BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury2"                     Operation="Addition" Left="$(NetLuxury2GainedFromTraitors)"     BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury3"                     Operation="Addition" Left="$(NetLuxury3GainedFromTraitors)"     BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury4"                     Operation="Addition" Left="$(NetLuxury4GainedFromTraitors)"     BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury5"                     Operation="Addition" Left="$(NetLuxury5GainedFromTraitors)"     BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury6"                     Operation="Addition" Left="$(NetLuxury6GainedFromTraitors)"     BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury7"                     Operation="Addition" Left="$(NetLuxury7GainedFromTraitors)"     BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury8"                     Operation="Addition" Left="$(NetLuxury8GainedFromTraitors)"     BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury9"                     Operation="Addition" Left="$(NetLuxury9GainedFromTraitors)"     BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury10"                    Operation="Addition" Left="$(NetLuxury10GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury11"                    Operation="Addition" Left="$(NetLuxury11GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury12"                    Operation="Addition" Left="$(NetLuxury12GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury13"                    Operation="Addition" Left="$(NetLuxury13GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury14"                    Operation="Addition" Left="$(NetLuxury14GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury15"                    Operation="Addition" Left="$(NetLuxury15GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury16"                    Operation="Addition" Left="$(NetLuxury16GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury17"                    Operation="Addition" Left="$(NetLuxury17GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury18"                    Operation="Addition" Left="$(NetLuxury18GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury19"                    Operation="Addition" Left="$(NetLuxury19GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
    <BinaryModifier TargetProperty="NetLuxury20"                    Operation="Addition" Left="$(NetLuxury20GainedFromTraitors)"    BinaryOperation="Multiplication" Right="$(TraitorGainsMultiplier)" Path="./ClassEmpire"/>
