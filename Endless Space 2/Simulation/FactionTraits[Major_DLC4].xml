  <!-- WHEN ADDING TRAITS THAT ARE RESTRICTED TO A SPECIFIC DLC, PLEASE LET A PROGRAMMER KNOW !
    CHANGES ARE REQUIRED ON THE CODE SIDE -->

  <FactionTrait Name="FactionTraitTechnologicalHeadStart" SubCategory="FactionTrait" TraitCategory="FactionTraitUnlockTechnologyStage" TraitSubCategory="TraitSubCategoryTechnologicalHeadStart" Family="FactionTraitFamilyStartingTechnologies" Hidden="false" Custom="true" Cost="70" HiddenOnFailPrerequisites="true" Level="2">

    <!-- The command "UnlockTechnologyStage" will unlock only these techs which passes the prerequistes validation,
        so we unlock them in order in case of any tech dependency appears-->
    <!-- To unlock specific techs use "UnlockTechnology" command.-->
    <Command Name="UnlockTechnologyStage"                Arguments="TechnologyStageDefinitionEconomyAndTrade1"/>
    <Command Name="UnlockTechnologyStage"                Arguments="TechnologyStageDefinitionEmpireDevelopment1"/>
    <Command Name="UnlockTechnologyStage"                Arguments="TechnologyStageDefinitionMilitary1"/>
    <Command Name="UnlockTechnologyStage"                Arguments="TechnologyStageDefinitionScienceAndExploration1"/>
    <Command Name="UnlockTechnologyStage"                Arguments="TechnologyStageDefinitionEconomyAndTrade2"/>
    <Command Name="UnlockTechnologyStage"                Arguments="TechnologyStageDefinitionEmpireDevelopment2"/>
    <Command Name="UnlockTechnologyStage"                Arguments="TechnologyStageDefinitionMilitary2"/>
    <Command Name="UnlockTechnologyStage"                Arguments="TechnologyStageDefinitionScienceAndExploration2"/>

    <SimulationDescriptorReference Name="FactionTraitTechnologicalHeadStart"/>
  </FactionTrait>

  <FactionTrait Name="FactionTraitTechnologicalHeadStartLess" SubCategory="FactionTrait" TraitCategory="FactionTraitUnlockTechnologyStage" TraitSubCategory="TraitSubCategoryTechnologicalHeadStart" Family="FactionTraitFamilyStartingTechnologies" Hidden="false" Custom="true" Cost="30" HiddenOnFailPrerequisites="true" Level="1">

