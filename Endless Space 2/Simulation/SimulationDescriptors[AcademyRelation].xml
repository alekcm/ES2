  </SimulationDescriptor>

  <SimulationDescriptor Name="AcademyRelationWithMajorPraise" Type="AcademyRelation">
    <Modifier TargetProperty="Trend" 			Operation="Addition"   			Value="2" 	Path="ClassAcademyRelationWithMajor" />
