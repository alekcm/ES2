<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/Amplitude.Unity.Simulation.SimulationDescriptor.xsd">

  <!-- ECONOMY -->

  <SimulationDescriptor Name="StarSystemImprovementQuestTemplars01" Type="StarSystemImprovement">
    <BinaryModifier TargetProperty="PlanetPrestige" Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedStarSystem/ClassColonizedPlanet" SearchValueFromPath="true"/>
    <Modifier TargetProperty="SystemEmpirePoint" Operation="Percent" Value="0.15" Path="./ClassColonizedStarSystem,AwokenSlumberingRuins"/>
    <Modifier TargetProperty="SystemEmpirePoint" Operation="Percent" Value="0.15" Path="./ClassColonizedStarSystem/ClassImprovement,StarSystemImprovementUniqueTemplars/./ClassColonizedStarSystem" UseIfInsteadOfWhere="true" />
    <Modifier TargetProperty="SystemEmpirePoint" Operation="Percent" Value="0.25"  Path="./ClassColonizedStarSystem"/>
  </SimulationDescriptor>
  <SimulationDescriptor Name="StarSystemImprovementQuestTemplars02" Type="StarSystemImprovement">
    <Modifier TargetProperty="Happiness" Operation="Addition" Value="10" Path="./ClassColonizedStarSystem,AwokenSlumberingRuins"/>
    <Modifier TargetProperty="Happiness" Operation="Addition" Value="10" Path="./ClassColonizedStarSystem/ClassImprovement,StarSystemImprovementUniqueTemplars/./ClassColonizedStarSystem" UseIfInsteadOfWhere="true" />
    <Modifier TargetProperty="Happiness" Operation="Addition" Value="20"  Path="./ClassColonizedStarSystem"/>
  </SimulationDescriptor>
  <SimulationDescriptor Name="StarSystemImprovementQuestTemplars03" Type="StarSystemImprovement">
    <Modifier TargetProperty="PlanetIndustry"    Operation="Addition" Value="2"  Path="./ClassColonizedStarSystem/ClassColonizedPlanet"/>
    <Modifier TargetProperty="SystemProduction" Operation="Percent" Value="0.15" Path="./ClassColonizedStarSystem,AwokenSlumberingRuins"/>
    <Modifier TargetProperty="SystemProduction" Operation="Percent" Value="0.15" Path="./ClassColonizedStarSystem/ClassImprovement,StarSystemImprovementUniqueTemplars/./ClassColonizedStarSystem" UseIfInsteadOfWhere="true" />
    <Modifier TargetProperty="SystemProduction" Operation="Percent" Value="0.25"  Path="./ClassColonizedStarSystem" EnforceContext="true" />
  </SimulationDescriptor>
  <SimulationDescriptor Name="StarSystemImprovementQuestTemplars04" Type="StarSystemImprovement">
    <Modifier TargetProperty="PlanetDust"    Operation="Addition" Value="4" Path="./ClassColonizedStarSystem/ClassColonizedPlanet"/>
    <Modifier TargetProperty="SystemMoney" Operation="Percent" Value="0.15" Path="./ClassColonizedStarSystem,AwokenSlumberingRuins"/>
    <Modifier TargetProperty="SystemMoney" Operation="Percent" Value="0.15" Path="./ClassColonizedStarSystem/ClassImprovement,StarSystemImprovementUniqueTemplars/./ClassColonizedStarSystem" UseIfInsteadOfWhere="true" />
    <Modifier TargetProperty="SystemMoney" Operation="Percent" Value="0.25"  Path="./ClassColonizedStarSystem"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="BuildingStarSystemImprovementUniqueTemplars" Type="BuildingStarSystemImprovement">
  </SimulationDescriptor>

  <SimulationDescriptor Name="StarSystemImprovementUniqueTemplars" Type="StarSystemImprovement">
    <Modifier TargetProperty="SystemFIDSIPercent"      Operation="Addition" Value="0.15"   Path="./ClassColonizedStarSystem"/>
    <Modifier TargetProperty="VisionRange"             Operation="Addition" Value="3"      Path="./ClassColonizedStarSystem"/>
    <Modifier TargetProperty="SystemInfluenceRadius"   Operation="Percent"	Value=".3"		 Path="./ClassColonizedStarSystem"/>
    <Modifier TargetProperty="RelicSlotsUnlocked"      Operation="Addition" Value="1"      Path="../ClassEmpire" Priority="1"/>
    <Modifier TargetProperty="HasCathedral"            Operation="Addition" Value="1"      Path="./ClassColonizedStarSystem" TooltipHidden="true"/>
    <!-- HP Regen Effects are tied to FleetState tag -->
  </SimulationDescriptor>

  <SimulationDescriptor Name="StarSystemImprovementUniqueTemplarsQueued" Type="StarSystemImprovement">
    <Modifier TargetProperty="TotalCathedralsIncludingInQueue" Operation="Addition" Value="1" Path="../ClassEmpire" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="StarSystemAwakenImprovementQueued" Type="StarSystemAwakenImprovement">
  </SimulationDescriptor>

  <SimulationDescriptor Name="StarSystemCollectRelicImprovementQueued" Type="StarSystemCollectRelicImprovement">
  </SimulationDescriptor>

  <!-- Magnetic Field Generators -->
  <SimulationDescriptor Name="StarSystemImprovementScience2Templars" Type="StarSystemImprovement">
    <BinaryModifier TargetProperty="SystemResearch"		Operation="Addition"	Left="$(ScienceBonusFromRelicsPerAnomaly)"    BinaryOperation="Multiplication"    Right="$(ResearchRelics)"     Path="./ClassColonizedStarSystem" SearchValueFromPath="true" TooltipOverride="%StarSystemImprovementScience2TemplarsTooltipOverride"/>
    <BinaryModifier TargetProperty="SystemResearch"		Operation="Addition"	Left="10"    BinaryOperation="Multiplication"    Right="$(OwnedColdPlanets)"     Path="./ClassColonizedStarSystem" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <!-- Graviton Shielded Laboratories -->
  <SimulationDescriptor Name="StarSystemImprovementScience4ScienceReduction" Type="StarSystemImprovement">
    <Modifier TargetProperty="SystemResearch" Operation="Addition" Value="10" Path="./ClassColonizedStarSystem"/>
    <Modifier TargetProperty="SystemResearch" Operation="Addition" Value="30" Path="./ClassColonizedStarSystem/ClassImprovement,StarSystemImprovementUniqueTemplars/./ClassColonizedStarSystem" UseIfInsteadOfWhere="true" />
    <Modifier TargetProperty="SystemResearch" Operation="Addition" Value="30" Path="./ClassColonizedStarSystem,AwokenSlumberingRuins"/>
    <BinaryModifier TargetProperty="SystemResearch"		Operation="Addition"	Left="5"    BinaryOperation="Multiplication"    Right="$(ResearchRelics)"     Path="./ClassColonizedStarSystem" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="StarSystemImprovementScience4SophonsScienceReduction" Type="StarSystemImprovement">
    <Modifier TargetProperty="SystemResearch" Operation="Addition" Value="100" Path="./ClassColonizedStarSystem"/>
  </SimulationDescriptor>

  <!-- Punctuated Evolution Foundation -->
  <SimulationDescriptor Name="StarSystemImprovementScience6Templars" Type="StarSystemImprovement">
    <BinaryModifier TargetProperty="SystemResearch"		Operation="Addition"	Left="$(ScienceBonusFromRelicsPerFertilePlanet)"    BinaryOperation="Multiplication"    Right="$(ResearchRelics)"     Path="./ClassColonizedStarSystem" SearchValueFromPath="true" TooltipOverride="%StarSystemImprovementScience6TemplarsTooltipOverride"/>
    <BinaryModifier TargetProperty="SystemResearch"		Operation="Addition"	Left="5"    BinaryOperation="Multiplication"    Right="$(ResearchRelics)"     Path="./ClassColonizedStarSystem" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <!-- Pocket Laboratory -->
  <SimulationDescriptor Name="StarSystemImprovementScienceOnGasTemplars" Type="StarSystemImprovement">
    <Modifier TargetProperty="SystemResearch" Operation="Percent" Value="0.2" Path="./ClassColonizedStarSystem"/>
    <Modifier TargetProperty="SystemResearch" Operation="Percent" Value="0.1" Path="./ClassColonizedStarSystem/ClassImprovement,StarSystemImprovementUniqueTemplars/./ClassColonizedStarSystem" UseIfInsteadOfWhere="true" />
    <Modifier TargetProperty="SystemResearch" Operation="Percent" Value="0.1" Path="./ClassColonizedStarSystem,AwokenSlumberingRuins"/>
  </SimulationDescriptor>

  <!-- School of Geniuses -->
  <SimulationDescriptor Name="StarSystemImprovementScience8Templars" Type="StarSystemImprovement">
    <BinaryModifier TargetProperty="SystemResearch" Operation="Addition"  Left="50" BinaryOperation="Multiplication" Right="$(OwnedAnomalies)" Path="./ClassColonizedStarSystem" SearchValueFromPath="true" />
  </SimulationDescriptor>

  <!-- Impervious Bunkers -->
  <SimulationDescriptor Name="StarSystemImprovementDefense1Templars" Type="StarSystemImprovement">
    <Modifier TargetProperty="MaximumSystemManpower"                          Operation="Addition"    Value="400"     Path="./ColonizedStarSystemStateColony,ClassColonizedStarSystem"/>
    <Modifier TargetProperty="GroundBattleDefenderManpowerLimit"              Operation="Addition"    Value="300"     Path="./ClassColonizedStarSystem"/>
    <Modifier TargetProperty="TroopHealthPerTemple"                           Operation="Addition"    Value="0.05"    Path="./ClassColonizedStarSystem"/>
    <Modifier TargetProperty="GroundBattleDefenderTroopsMaxHealthMultiplier" Operation="Addition"    Value="0.1"     Path="./ClassColonizedStarSystem/ClassImprovement,StarSystemImprovementUniqueTemplars/./ClassColonizedStarSystem" UseIfInsteadOfWhere="true" />
    <Modifier TargetProperty="GroundBattleDefenderTroopsMaxHealthMultiplier"  Operation="Addition"    Value="0.1"     Path="./ClassColonizedStarSystem,AwokenSlumberingRuins"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="StarSystemImprovementOnlyOnAwakenedRuins" Type="StarSystemImprovement"/>
</Datatable>