  </SimulationDescriptor>
  
  <SimulationDescriptor Name="EmpireImprovementQuestUniquePlanet13"      Type="EmpireImprovement">
    <BinaryModifier TargetProperty="EmpireMoney"             Operation="Percent"   Left="0.02"              BinaryOperation="Multiplication"    Right="$(GovernorAssigned)"  Path="ClassEmpire" TooltipOverride="%EmpireImprovementQuestUniquePlanet13TooltipEffect" />
  </SimulationDescriptor>
  
  <SimulationDescriptor Name="EmpireImprovementQuestUniquePlanet14"      Type="EmpireImprovement">
    <BinaryModifier TargetProperty="EmpireMoney"             Operation="Percent"   Left="0.02"              BinaryOperation="Multiplication"    Right="$(AdmiralAssigned)"  Path="ClassEmpire" TooltipOverride="%EmpireImprovementQuestUniquePlanet14TooltipEffect" />
  </SimulationDescriptor>


  <SimulationDescriptor Name="EmpireImprovementQuestUniquePlanet15"      Type="EmpireImprovement">
