    <Modifier TargetProperty="TankDamagesBonus"    Operation="Addition"    Value="0.2" Path="ClassEmpire"/>
  </SimulationDescriptor>


  <SimulationDescriptor Name="EmpireImprovementQuestUniquePlanet17"      Type="EmpireImprovement">
    <Modifier TargetProperty="PlaneManpowerCost"    Operation="Percent"    Value="-0.2" Path="ClassEmpire"/>
    <Modifier TargetProperty="PlaneDamagesBonus"    Operation="Addition"    Value="0.2" Path="ClassEmpire"/>
  </SimulationDescriptor>


  <SimulationDescriptor Name="EmpireImprovementQuestUniquePlanet18"      Type="EmpireImprovement">   
