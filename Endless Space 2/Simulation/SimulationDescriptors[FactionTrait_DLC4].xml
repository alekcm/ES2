<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/Amplitude.Unity.Simulation.SimulationDescriptor.xsd">

  <!-- ########################################## -->
  <!-- ######        MAJOR FACTIONS        ###### -->
  <!-- ########################################## -->
  <SimulationDescriptor Name="AffinityGameplayTemplars" Type="AffinityGameplay">
    <Property Name="SystemsGivenToAcademy" BaseValue="0" MinValue="0"/>
    <Modifier TargetProperty="CanUseTemples"                Operation="Addition"    Value="1"                                                                   TooltipHidden="true"/>
    <Modifier TargetProperty="PlanetInitialFIDSPenalty"     Operation="Force"       Value="0"   Path="ClassEmpire/ClassColonizedStarSystem/PlanetTypeForest"    TooltipHidden="true"/>
    <Modifier TargetProperty="PlanetInitialFIDSPenalty"     Operation="Force"       Value="0"   Path="ClassEmpire/ClassColonizedStarSystem/PlanetTypeTerran"    TooltipHidden="true"/>
    <Modifier TargetProperty="PlanetInitialFIDSPenalty"     Operation="Force"       Value="0"   Path="ClassEmpire/ClassColonizedStarSystem/PlanetTypeMonsoon"   TooltipHidden="true"/>
    <Modifier TargetProperty="PlanetInitialFIDSPenalty"     Operation="Force"       Value="0"   Path="ClassEmpire/ClassColonizedStarSystem/PlanetTypeOcean"     TooltipHidden="true"/>
    <Modifier TargetProperty="PlanetInitialFIDSPenalty"     Operation="Force"       Value="0"   Path="ClassEmpire/ClassColonizedStarSystem/PlanetTypeAtoll"     TooltipHidden="true"/>
    <Modifier TargetProperty="PlanetInitialFIDSPenalty"     Operation="Force"       Value="0"   Path="ClassEmpire/ClassColonizedStarSystem/PlanetTypeBoreal"    TooltipHidden="true"/>
    <Modifier TargetProperty="PlanetInitialFIDSPenalty"     Operation="Force"       Value="0"   Path="ClassEmpire/ClassColonizedStarSystem/PlanetTypeJungle"    TooltipHidden="true"/>
    <Modifier TargetProperty="PlanetInitialFIDSPenalty"     Operation="Force"       Value="0"   Path="ClassEmpire/ClassColonizedStarSystem/PlanetTypeFake"      TooltipHidden="true"/>
    <Modifier TargetProperty="PlanetInitialFIDSBonus"       Operation="Addition"    Value="-0.5" Path="ClassEmpire/ClassColonizedStarSystem/ClassColonizedPlanet"/>
    <Modifier TargetProperty="CanConvertSystem"             Operation="Addition"    Value="1"    Path="ClassEmpire" TooltipHidden="true"/>
  </SimulationDescriptor>

  <!-- #######         ACADEMY TRAITS          ##### -->

  <!-- Academy Tag -->
  <SimulationDescriptor Name="IsAcademyFaction" Type="IsAcademy">
  </SimulationDescriptor>

  <!-- #######         MAJOR TRAITS            ##### -->

  <!-- Technologocal Head Start-->
  <SimulationDescriptor Name="FactionTraitTechnologicalHeadStart" Type="FactionTrait">
  </SimulationDescriptor>
  <SimulationDescriptor Name="FactionTraitTechnologicalHeadStartLess" Type="FactionTrait">
  </SimulationDescriptor>

  <SimulationDescriptor Name="FactionTraitScienceReduction" Type="FactionTrait">
    <Modifier TargetProperty="PlanetScienceModifier"              Operation="Force"   Value="0"    Path="ClassEmpire/ClassColonizedStarSystem/ClassColonizedPlanet" TooltipOverride="%FactionTraitScienceReductionEffectOverride1"/>
    <Modifier TargetProperty="NetSystemResearch"                  Operation="Multiplication" Value="0.5" Path="ClassEmpire/ClassColonizedStarSystem"    Priority="10"    />
    <Modifier TargetProperty="CanUseRawPlanetScience"             Operation="Force"   Value="0"    Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="CannotUseRawPlanetScience"          Operation="Force"   Value="1"    Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="CanUseRawPlanetScience"             Operation="Force"   Value="0"    Path="ClassEmpire/ClassColonizedStarSystem" TooltipHidden="true"/>
    <Modifier TargetProperty="CannotUseRawPlanetScience"          Operation="Force"   Value="1"    Path="ClassEmpire/ClassColonizedStarSystem" TooltipHidden="true"/>
    <Modifier TargetProperty="PartnerScienceTradingCostReduction" Operation="Percent" Value="3"    Path="ClassEmpire" TooltipOverride="%FactionTraitScienceReductionEffectOverride2"/>
    <Modifier TargetProperty="ScienceScrappingBonus"              Operation="Percent" Value="-0.5" Path="ClassEmpire" TooltipOverride="%FactionTraitScienceReductionEffectOverride3"/>
  </SimulationDescriptor>


  <!-- #######         MINOR TRAITS               ##### -->

  <SimulationDescriptor Name="FactionTraitMinorBonusDamageOnAcademy" Type="FactionTraitMinor">
    <Modifier TargetProperty="AdditionalOpponentRecyclingDustPerCP" Operation="Addition" Value="15"  Path="ClassEmpire//ClassShip"/>
    <Modifier TargetProperty="MinorTraitsAssimilated" Operation="Addition" Value="1"   Path="ClassEmpire"                                                                                   TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="FactionTraitMinorBonusContributionToAcademy" Type="FactionTraitMinor">
    <BinaryModifier TargetProperty="SystemMoney"                 Operation="Addition" Left="1" BinaryOperation="Multiplication" Right="$(CuriositiesDiscovered)" Path="ClassEmpire/ClassColonizedStarSystem"/>
    <Modifier TargetProperty="MinorTraitsAssimilated"                   Operation="Addition" Value="1"   Path="ClassEmpire" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="FactionTraitSlumberingRuins" Type="FactionTrait">
    <Modifier TargetProperty="CanSuperColonizeSlumberingRuins"          Operation="Force" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="CanSeeSlumberingRuins"                    Operation="Force" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="BaseTurnsBeforeNextFreeSuperColonization" Operation="Force" Value="0" Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="TurnsBeforeNextFreeSuperColonization"     Operation="Force" Value="0" Path="ClassEmpire" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="FactionTraitSlumberingRuinsNonTemplars" Type="FactionTrait">
    <Modifier TargetProperty="CanSuperColonizeSlumberingRuins"          Operation="Force" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="CanSeeSlumberingRuins"                    Operation="Force" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="BaseTurnsBeforeNextFreeSuperColonization" Operation="Force" Value="0" Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="TurnsBeforeNextFreeSuperColonization"     Operation="Force" Value="0" Path="ClassEmpire" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="FactionTraitSlumberingRuinsVaulters" Type="FactionTrait">
    <Modifier TargetProperty="CanSuperColonizeSlumberingRuins"          Operation="Force" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="CanSeeSlumberingRuins"                    Operation="Force" Value="1" Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="BaseTurnsBeforeNextFreeSuperColonization" Operation="Force" Value="0" Path="ClassEmpire" TooltipHidden="true"/>
    <Modifier TargetProperty="TurnsBeforeNextFreeSuperColonization"     Operation="Force" Value="0" Path="ClassEmpire" TooltipHidden="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="FactionTraitMinorMinorOraculars" Type="FactionTraitMinor"/>
  <SimulationDescriptor Name="FactionTraitConstellationVision" Type="FactionTrait"/>
  <SimulationDescriptor Name="FactionTraitAcademyBesties" Type="FactionTrait">
    <Modifier TargetProperty="AcademyRelationPointCostMultiplier" Operation="Percent" Value="-0.2"   Path="ClassEmpire"/>
  </SimulationDescriptor>
</Datatable>