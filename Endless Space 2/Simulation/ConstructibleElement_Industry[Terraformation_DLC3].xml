<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/IndustryConstructibleElement.xsd">

    <!-- Sizoformation -->
    <!-- Small to medium -->
    <PlanetTerraformationDefinition Name="PlanetTerraformationFromSmallFakeToMediumFake" SubCategory="PlanetTerraformationSize">
        <AIGain RessourceName="IndustryGain"/>
        <AIGain RessourceName="ScienceGain"/>
        <AIGain RessourceName="FoodGain"/>
        <AIGain RessourceName="DustGain"/>
        <AIGain RessourceName="InfluenceGain"/>

        <Tags>PlanetTerraformationFromSmallFake,PlanetTerraformationOnlyViaSystem</Tags>

        <CustomCost ResourceName="SystemProduction">250 * Property(StockLocation, @../ClassEmpire, TerraformationModifier)</CustomCost>

        <PathPrerequisite Flags="Prerequisite,Discard,CheckOnEmpire">../ClassEmpire,AffinityGameplayUmbralChoir</PathPrerequisite>
        <PathPrerequisite Flags="Prerequisite,Discard">../ClassEmpire,EmpireImprovementTerraformationUmbralChoir1</PathPrerequisite>
        <PathPrerequisite Flags="Prerequisite,Discard,CheckOnPlanet">PlanetTypeFake</PathPrerequisite>
        <PathPrerequisite Flags="Prerequisite,Discard,CheckOnPlanet">PlanetSizeSmall</PathPrerequisite>

        <SimulationDescriptorReference Name="PlanetSizeMedium"/>
        <SimulationDescriptorReference Name="PlanetTypeFakeResourceIncreaseForMedium"/>

        <RemovedType>PlanetSize</RemovedType>
        <RemovedType>PlanetTypeFakeResourceIncrease</RemovedType>
    </PlanetTerraformationDefinition>

    <!-- Medium to large -->
    <PlanetTerraformationDefinition Name="PlanetTerraformationFromMediumFakeToLargeFake" SubCategory="PlanetTerraformationSize">
        <AIGain RessourceName="IndustryGain"/>
        <AIGain RessourceName="ScienceGain"/>
        <AIGain RessourceName="FoodGain"/>
        <AIGain RessourceName="DustGain"/>

        <Tags>PlanetTerraformationFromMediumFake,PlanetTerraformationOnlyViaSystem</Tags>

        <CustomCost ResourceName="SystemProduction">500 * Property(StockLocation, @../ClassEmpire, TerraformationModifier)</CustomCost>

        <PathPrerequisite Flags="Prerequisite,Discard,CheckOnEmpire">../ClassEmpire,AffinityGameplayUmbralChoir</PathPrerequisite>
        <PathPrerequisite Flags="Prerequisite,Discard">../ClassEmpire,EmpireImprovementTerraformationUmbralChoir2</PathPrerequisite>
        <PathPrerequisite Flags="Prerequisite,Discard,CheckOnPlanet">PlanetTypeFake</PathPrerequisite>
        <PathPrerequisite Flags="Prerequisite,Discard,CheckOnPlanet">PlanetSizeMedium</PathPrerequisite>

        <SimulationDescriptorReference Name="PlanetSizeLarge"/>
        <SimulationDescriptorReference Name="PlanetTypeFakeResourceIncreaseForLarge"/>

        <RemovedType>PlanetSize</RemovedType>
        <RemovedType>PlanetTypeFakeResourceIncrease</RemovedType>
    </PlanetTerraformationDefinition>

    <!-- Large to huge -->
    <PlanetTerraformationDefinition Name="PlanetTerraformationFromLargeFakeToHugeFake" SubCategory="PlanetTerraformationSize">
        <AIGain RessourceName="IndustryGain"/>
        <AIGain RessourceName="ScienceGain"/>
        <AIGain RessourceName="FoodGain"/>
        <AIGain RessourceName="DustGain"/>
        
        <Tags>PlanetTerraformationFromMediumFake,PlanetTerraformationOnlyViaSystem</Tags>

        <CustomCost ResourceName="SystemProduction">750 * Property(StockLocation, @../ClassEmpire, TerraformationModifier)</CustomCost>

        <PathPrerequisite Flags="Prerequisite,Discard,CheckOnEmpire">../ClassEmpire,AffinityGameplayUmbralChoir</PathPrerequisite>
        <PathPrerequisite Flags="Prerequisite,Discard">../ClassEmpire,EmpireImprovementTerraformationUmbralChoir3</PathPrerequisite>
        <PathPrerequisite Flags="Prerequisite,Discard,CheckOnPlanet">PlanetTypeFake</PathPrerequisite>
        <PathPrerequisite Flags="Prerequisite,Discard,CheckOnPlanet">PlanetSizeLarge</PathPrerequisite>

        <SimulationDescriptorReference Name="PlanetSizeHuge"/>
        <SimulationDescriptorReference Name="PlanetTypeFakeResourceIncreaseForHuge"/>

        <RemovedType>PlanetSize</RemovedType>
        <RemovedType>PlanetTypeFakeResourceIncrease</RemovedType>
    </PlanetTerraformationDefinition>

</Datatable>