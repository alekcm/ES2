<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/Amplitude.Unity.Simulation.SimulationDescriptor.xsd">

  <!--HeroSkill128-->
  <SimulationDescriptor Name="HeroSkillShip128_Probe_0" Type="HeroSkillShip" IsSerializable="false">
    <Modifier TargetProperty="MaximumShipProbeStock"							Operation="Addition"		Value="1"		Path="./ClassGarrisonFleet/ClassShip,ShipRoleExploration" />
    <Modifier TargetProperty="NetShipProbe"										Operation="Addition"		Value="0.20"	Path="./ClassGarrisonFleet/ClassShip,ShipRoleExploration" />
  </SimulationDescriptor>
  <SimulationDescriptor Name="HeroSkillShip128_Probe_1" Type="HeroSkillShip" IsSerializable="false">
    <Modifier TargetProperty="MaximumShipProbeStock"							Operation="Addition"		Value="2"		Path="./ClassGarrisonFleet/ClassShip,ShipRoleExploration" />
    <Modifier TargetProperty="NetShipProbe"										Operation="Addition"		Value="0.40"	Path="./ClassGarrisonFleet/ClassShip,ShipRoleExploration" />
  </SimulationDescriptor>

  <!--HeroSkill129-->
  <SimulationDescriptor Name="HeroSkillShip129_Vision_0" Type="HeroSkillShip" IsSerializable="false">
    <Modifier TargetProperty="SentryActionLevel" Operation="Addition" Value="1" Path="./ClassGarrisonFleet" TooltipOverride="%HeroSkillShip129_Vision_0_TooltipOverride"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="HeroSkillShip129_Vision_1" Type="HeroSkillShip" IsSerializable="false">
    <Modifier TargetProperty="SentryActionLevel" Operation="Addition" Value="2" Path="./ClassGarrisonFleet" TooltipOverride="%HeroSkillShip129_Vision_1_TooltipOverride"/>
  </SimulationDescriptor>

  <!--HeroSkill130-->
  <SimulationDescriptor Name="HeroSkillSystem130_Planet_FIDS_0" Type="HeroSkillSystem" IsSerializable="false">
    <Modifier TargetProperty="MinimumFIDS"             Operation="Force"    Value="2"     Path="ClassColonizedStarSystem/ClassColonizedPlanet"/>
    <Modifier TargetProperty="HappinessMalusReduction" Operation="Addition" Value="-0.2"  Path="ClassColonizedStarSystem/ClassColonizedPlanet"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="HeroSkillSystem130_Planet_FIDS_1" Type="HeroSkillSystem" IsSerializable="false">
    <Modifier TargetProperty="MinimumFIDS"             Operation="Force"    Value="4"     Path="ClassColonizedStarSystem/ClassColonizedPlanet"/>
    <Modifier TargetProperty="HappinessMalusReduction" Operation="Addition" Value="-0.4"  Path="ClassColonizedStarSystem/ClassColonizedPlanet"/>
  </SimulationDescriptor>

  <!--HeroSkill131-->
  <SimulationDescriptor Name="HeroSkillSystem131_System_Temple_0" Type="HeroSkillSystem" IsSerializable="false">
    <BinaryModifier TargetProperty="SystemFIDSIPercent"                            Operation="Addition"        Left="0.05" BinaryOperation="Multiplication"  Right="$(AllianceCount)" />
  </SimulationDescriptor>
  <SimulationDescriptor Name="HeroSkillSystem131_System_Temple_1" Type="HeroSkillSystem" IsSerializable="false">
    <BinaryModifier TargetProperty="SystemFIDSIPercent"                            Operation="Addition"        Left="0.1" BinaryOperation="Multiplication"  Right="$(AllianceCount)" />
  </SimulationDescriptor>

  <SimulationDescriptor Name="HeroSkillSenator122_FIDSI_0" Type="HeroSkillSenator" IsSerializable="false">
    <Modifier TargetProperty="HeroPointMultiplier" Operation="Addition" Value="0.25" Path="../ClassEmpire"/>
    <Modifier TargetProperty="AssignmentCooldownDecrementPerTurn"    Operation="Percent"  Value="0.25" Path="../ClassEmpire//ClassHero"/>
  </SimulationDescriptor>

  <!--HeroSkill70-->
  <SimulationDescriptor Name="HeroSkillSystem70Templars_ApprovalFood_PercentFlat_1" Type="HeroSkillSystem" IsSerializable="false">
    <Modifier TargetProperty="Happiness"										Operation="Addition"			Value="5"		Path="ClassColonizedStarSystem"/>
    <Modifier TargetProperty="SystemEmpirePointFromHisshoBonus"					Operation="Addition"			Value="2"		Path="ClassColonizedStarSystem"/>
    <Modifier TargetProperty="SystemGrowth"										Operation="Percent"				Value="0.05"		Path="ClassColonizedStarSystem"/>
  </SimulationDescriptor>
  <SimulationDescriptor Name="HeroSkillSystem70Templars_ApprovalFood_PercentFlat_2" Type="HeroSkillSystem" IsSerializable="false">
    <Modifier TargetProperty="Happiness"										Operation="Addition"			Value="10"		Path="ClassColonizedStarSystem"/>
    <Modifier TargetProperty="SystemEmpirePointFromHisshoBonus"					Operation="Addition"			Value="2"		Path="ClassColonizedStarSystem"/>
    <Modifier TargetProperty="SystemGrowth"										Operation="Percent"				Value="0.1"		Path="ClassColonizedStarSystem"/>
  </SimulationDescriptor>

  <!-- Siege Skill -->
  <SimulationDescriptor Name="HeroSkillShipTemplars02_1" Type="HeroSkillShip" IsSerializable="false">
    <Modifier TargetProperty="SiegePower"  Operation="Percent" Value="0.15" Path="./ClassGarrisonFleet"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="HeroSkillHostileOrbitTemplars02_1" Type="HeroSkillHostileOrbit" IsSerializable="false">
    <Modifier TargetProperty="GroundBattleBombardmentDefenderDamages" Operation="Addition" Value="400" Path="ClassColonizedStarSystem"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="HeroSkillShipTemplars02_2" Type="HeroSkillShip" IsSerializable="false">
    <Modifier TargetProperty="SiegePower"  Operation="Percent" Value="0.25" Path="./ClassGarrisonFleet"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="HeroSkillHostileOrbitTemplars02_2" Type="HeroSkillHostileOrbit" IsSerializable="false">
    <Modifier TargetProperty="GroundBattleBombardmentDefenderDamages" Operation="Addition" Value="800" Path="ClassColonizedStarSystem"/>
  </SimulationDescriptor>

  <!-- Relic -->
  <SimulationDescriptor Name="HeroSkillHero_RelicBoost" Type="HeroSkill" IsSerializable="false">
    <Modifier TargetProperty="HealthPerTurn"	                  Operation="Percent"     Value="0.5"       Path="ClassHero"/>
    <Modifier TargetProperty="AssignmentCooldownBaseDuration"		Operation="Percent"			Value="-0.5"	    Path="ClassHero"/>
    <Modifier TargetProperty="ExperienceMultiplier"		          Operation="Percent"			Value="0.25"	    Path="ClassHero"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="HeroSkillSystem_RelicBoost" Type="HeroSkillSystem" IsSerializable="false">
    <BinaryModifier TargetProperty="Happiness"					        Operation="Addition"	  Left="10"	        BinaryOperation="Multiplication" Right="$(NumberOfTemples)" Path="ClassColonizedStarSystem" SearchValueFromPath="true"/>
    <Modifier TargetProperty="SystemFIDSIPercent" Operation="Addition" Value="0.15" Path="ClassColonizedStarSystem,HappinessStatusStarSystem4"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="HeroSkillShip_RelicBoost" Type="HeroSkillShip" IsSerializable="false">
    <Modifier TargetProperty="FleetMaximumShield"								Operation="Addition"		Value="0.05"		  Path="./ClassGarrisonFleet" />
    <Modifier TargetProperty="FleetMaximumHealth"								Operation="Addition"		Value="0.05"	    Path="./ClassGarrisonFleet" />
    <Modifier TargetProperty="ShipDamage"										    Operation="Addition"		Value="0.05"	    Path="./ClassGarrisonFleet" />
    <Modifier TargetProperty="Evasion"											    Operation="Addition"    Value="0.05"	    Path="./ClassGarrisonFleet"/>
  </SimulationDescriptor>
</Datatable>