    <BinaryModifier TargetProperty="PlanetDust"    Operation="Addition" Left="3" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet,PlanetGameplayTypeMeager" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <!-- INFLUENCE PLANETARY IMPROVEMENT -->

  <SimulationDescriptor Name="PlanetImprovementInfluence1" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetPrestige"    Operation="Addition" Left="1" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementInfluence2" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetPrestige"    Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementInfluence3" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetPrestige"    Operation="Addition" Left="3" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <!-- RESOURCES PLANETARY IMPROVEMENT -->

  <SimulationDescriptor Name="PlanetImprovementResource1" Type="PlanetImprovement">
    <Modifier TargetProperty="ResourceBonus"       Operation="Addition" Value="1"     Path="./ClassColonizedPlanet/ClassResourceDeposit"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementResource2" Type="PlanetImprovement">
    <Modifier TargetProperty="ResourceBonus"       Operation="Addition" Value="2"     Path="./ClassColonizedPlanet/ClassResourceDeposit"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementResource3" Type="PlanetImprovement">
    <Modifier TargetProperty="ResourceBonus"       Operation="Addition" Value="3"     Path="./ClassColonizedPlanet/ClassResourceDeposit"/>
  </SimulationDescriptor>

  <!-- HISSHOS -->

  <SimulationDescriptor Name="PlanetImprovementFIDS1" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetFIDS"    Operation="Addition" Left="1" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementFIDS2" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetFIDS"    Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementFIDS3" Type="PlanetImprovement">
