    <BinaryModifier TargetProperty="PlanetScience"    Operation="Addition" Left="1" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet,PlanetGameplayTypeCold" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementScience2" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetScience"    Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
    <BinaryModifier TargetProperty="PlanetScience"    Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet,PlanetGameplayTypeCold" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementScience3" Type="PlanetImprovement">
