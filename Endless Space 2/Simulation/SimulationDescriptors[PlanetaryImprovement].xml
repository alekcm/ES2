  </SimulationDescriptor>

  <!-- TEMPLARS -->

  <!-- TEMPLES -->
  <SimulationDescriptor Name="PlanetImprovementTemple1Descriptor" Type="PlanetImprovement">

    <Property Name="TemplePlanetPopulation" BaseValue="0"/>

    <Modifier TargetProperty="PlanetInitialFIDSBonus"       Operation="Force"     Value="0" Path="./ClassColonizedPlanet" TooltipOverride="%PlanetImprovementTemple1TooltipOverride"/>

    <Modifier TargetProperty="NumberOfTemples"         Operation="Addition"    Value="1"   Path="../ClassColonizedStarSystem" TooltipHidden="true"/>
    <Modifier TargetProperty="TempleRelics"            Operation="Addition"    Value="1"   Path="../ClassEmpire"  TooltipHidden="true"/>
    <Modifier TargetProperty="ResultingResearchRelics" Operation="Subtraction" Value="1"   Path="../ClassEmpire"  TooltipHidden="true" />
    <BinaryModifier TargetProperty="PlanetInitialPrestige" Operation="Addition" Left="$(TempleScienceToInfluenceFactor)" BinaryOperation="Multiplication" Right="$(PlanetInitialScience)" Path="./ClassColonizedPlanet" SearchValueFromPath="true" TooltipHidden="true"/>

    <Modifier TargetProperty="HasTemple" Operation="Addition" Value="1" Path="./ClassColonizedPlanet" TooltipHidden="true"/>

  </SimulationDescriptor>

  <SimulationDescriptor Name="BuildingStarSystemImprovementTempleRelicCost" Type="BuildingStarSystemImprovement">
    <!--Applied only when in build queue-->
    <Modifier TargetProperty="TempleRelics"            Operation="Addition"    Value="1"   Path="../ClassEmpire" Priority="-1"/>
    <Modifier TargetProperty="ResultingResearchRelics" Operation="Subtraction" Value="1"   Path="../ClassEmpire" TooltipHidden="true" />
  </SimulationDescriptor>

  <!-- SCIENCE PLANETARY IMPROVEMENT FOR TEMPLARS -->

  <SimulationDescriptor Name="PlanetImprovementTemplarsScience1" Type="PlanetImprovement">
    <Modifier       TargetProperty="SystemResearch"     Operation="Addition"     Value="10"  Path="../ClassColonizedStarSystem"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementTemplarsScience2" Type="PlanetImprovement">
    <Modifier       TargetProperty="SystemResearch"     Operation="Addition"     Value="20"  Path="../ClassColonizedStarSystem"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementTemplarsScience3" Type="PlanetImprovement">
    <Modifier       TargetProperty="SystemResearch"     Operation="Addition"     Value="30"  Path="../ClassColonizedStarSystem"/>
  </SimulationDescriptor>
</Datatable>