  <SimulationDescriptor Name="PlanetImprovementIndustry3" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetIndustry"    Operation="Addition" Left="3" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
    <BinaryModifier TargetProperty="PlanetIndustry"    Operation="Addition" Left="3" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet,PlanetGameplayTypeHot" SearchValueFromPath="true"/>
