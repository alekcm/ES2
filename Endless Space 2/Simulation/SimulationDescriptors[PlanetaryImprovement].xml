    <BinaryModifier TargetProperty="PlanetIndustry"    Operation="Addition" Left="1" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet,PlanetGameplayTypeHot" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementIndustry2" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetIndustry"    Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
    <BinaryModifier TargetProperty="PlanetIndustry"    Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet,PlanetGameplayTypeHot" SearchValueFromPath="true"/>
