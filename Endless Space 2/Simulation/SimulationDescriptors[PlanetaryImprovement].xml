    <BinaryModifier TargetProperty="PlanetScience"    Operation="Addition" Left="3" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet,PlanetGameplayTypeCold" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <!-- DUST PLANETARY IMPROVEMENT -->

  <SimulationDescriptor Name="PlanetImprovementDust1" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetDust"    Operation="Addition" Left="1" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
    <BinaryModifier TargetProperty="PlanetDust"    Operation="Addition" Left="1" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet,PlanetGameplayTypeMeager" SearchValueFromPath="true"/>
  </SimulationDescriptor>

  <SimulationDescriptor Name="PlanetImprovementDust2" Type="PlanetImprovement">
    <BinaryModifier TargetProperty="PlanetDust"    Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet" SearchValueFromPath="true"/>
    <BinaryModifier TargetProperty="PlanetDust"    Operation="Addition" Left="2" BinaryOperation="Multiplication" Right="$(Population)" Path="./ClassColonizedPlanet,PlanetGameplayTypeMeager" SearchValueFromPath="true"/>
