    <QuestDefinition Name="TestTraceStarted" Category="Test" SubCategory="">

        <!--============ TAGS ============-->
        <Tags></Tags>

        <QuestContextSolo/>
        <RepetitionRules  NumberOfOccurrencesPerGame="0"
                          NumberOfOccurrencesPerEmpire="1"
                          NumberOfConcurrentInstances="0"/>


        <!--============ VARIABLES ============-->
        <Vars>
            <Var VarName="$CurrentEmpire">
                <From Source="$Empire"/>
            </Var>
            <Var VarName="$TargetEmpire">
                <First>
                    <From Source="$MajorEmpires">
                        <Where>
                            <IsNot EntityVarName="$CurrentEmpire"/>
                        </Where>
                    </From>
                </First>
            </Var>
            <Var VarName="$Node"/>
        </Vars>

        <!--============ STEPS ============-->
        <Steps>
            <Step Name="Step1">
                <ObjectiveSet>
                    <Objective Name="Step1_Objective1">
                        <Sequence>
                            <Decorator_HackingOperationStarted HackingOperationFilter="OnlyTrace">
                                <Input_HackerEmpire VarName="$CurrentEmpire"/>
                                <Input_TracedEmpire VarName="$TargetEmpire"/>
                                <Output_Node VarName="$Node"/>
                            </Decorator_HackingOperationStarted>
                            <Decorator_BeginTurn/>
                        </Sequence>
                    </Objective>
                </ObjectiveSet>
            </Step>
        </Steps>

    </QuestDefinition>

