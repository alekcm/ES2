  <QuestDefinition Name="QuestSpawnRuins" Category="GalaxyGeneration" SubCategory="SlumberingRuins" MinimumTurn="0">

    <!--============ TAGS ============-->
    <Tags>BeginTurn,Hidden</Tags>

    <!--============ CONTEXT ============-->
    <QuestContextSolo/>

    <!--============ OCCURRENCE RULES ============-->
    <RepetitionRules NumberOfOccurrencesPerEmpire="1"/>

    <!--============ VARIABLES ============-->
    <Vars>
      <!-- Current player -->
      <Var VarName="$CurrentEmpire">
        <From Source="$Empire"/>
      </Var>

      <Var VarName="$HomeSystem">
        <From Source="$CurrentEmpire.$StartingNode"/>
      </Var>

      <!-- Tag to apply -->
      <Var VarName="$SlumberingTag" StringValue="SlumberingRuins"/>

      <!-- Untaken star systems -->
      <Var VarName="$AvailableStarSystems">
        <From Source="$Constellations.$StarSystems">
          <Where>
            <PathPrerequisite Inverted="true" Flags="Prerequisite">ClassStarSystem,IsolatedNode</PathPrerequisite>
            <PathPrerequisite Inverted="true" Flags="Prerequisite">ClassStarSystem,QuestNode</PathPrerequisite>
            <PathPrerequisite Inverted="true" Flags="Prerequisite">ClassStarSystem,SlumberingRuins</PathPrerequisite>
            <PathPrerequisite Inverted="true" Flags="Prerequisite">ClassStarSystem,AwokenSlumberingRuins</PathPrerequisite>
            <PathPrerequisite Inverted="true" Flags="Prerequisite">ClassStarSystem,MajorHomeSystem</PathPrerequisite>
            <PathPrerequisite Inverted="true" Flags="Prerequisite">ClassStarSystem,MinorHomeSystem</PathPrerequisite>
            <PathPrerequisite Inverted="true" Flags="Prerequisite">ClassStarSystem,AcademyHomeSystem</PathPrerequisite>
            <InterpreterPrerequisite Flags="Prerequisite">Count(Context, @'ClassStarSystem/ClassPlanet') gt 1</InterpreterPrerequisite>
          </Where>
        </From>
      </Var>

      <Var VarName="$NearbySystems">
        <Randomize>
          <From Source="$AvailableStarSystems">
            <Where>
              <FilterSystemByDistance OriginVarName="$HomeSystem" MaxDistance="50"/>
            </Where>
          </From>
        </Randomize>
      </Var>

      <Var VarName="$FurtherSystems">
        <Randomize>
          <From Source="$AvailableStarSystems">
            <Where>
              <FilterSystemByDistance OriginVarName="$HomeSystem" MinDistance="60" MaxDistance="100"/>
            </Where>
          </From>
        </Randomize>
      </Var>

      <Var VarName="$FarSystems">
        <Randomize>
          <From Source="$AvailableStarSystems">
            <Where>
              <FilterSystemByDistance OriginVarName="$HomeSystem" MinDistance="80" MaxDistance="150"/>
            </Where>
          </From>
        </Randomize>
      </Var>

      <!-- Target systems -->
      <Var VarName="$TargetNearby">
        <Any>
          <From Source="$NearbySystems"/>
        </Any>
      </Var>

      <Var VarName="$TargetFurther">
        <Any>
          <From Source="$FurtherSystems">
            <Where>
              <IsNot EntityVarName="$TargetNearby"/>
            </Where>
          </From>
        </Any>
      </Var>

      <Var VarName="$TargetFar">
        <Any>
          <From Source="$FarSystems">
            <Where>
              <IsNot EntityVarName="$TargetNearby"/>
              <IsNot EntityVarName="$TargetFurther"/>
            </Where>
          </From>
        </Any>
      </Var>
    </Vars>

    <!--============ PREREQUISITES ============-->
    <Prerequisites Target="$(Empire)">
      <DownloadableContentPrerequisite Flags="Prerequisite,Discard">DLCTemplars</DownloadableContentPrerequisite>
      <InterpreterPrerequisite Flags="Prerequisite,Discard">Property(Context,@../ClassEmpire, CanSuperColonizeSlumberingRuins) ge 1</InterpreterPrerequisite>
    </Prerequisites>

    <!--============ STEPS ============-->
    <Steps>
      <Step Name="Step1">
        <ObjectiveSet>
          <Objective Name="ApplyTags">
            <Sequence>
              <Action_ApplyDescriptor>
                <Input_DescriptorName VarName="$SlumberingTag"/>
                <Input_Targets        VarName="$TargetNearby"/>
              </Action_ApplyDescriptor>
              <Action_ApplyDescriptor>
                <Input_DescriptorName VarName="$SlumberingTag"/>
                <Input_Targets        VarName="$TargetFurther"/>
              </Action_ApplyDescriptor>
              <Action_ApplyDescriptor>
                <Input_DescriptorName VarName="$SlumberingTag"/>
                <Input_Targets        VarName="$TargetFar"/>
              </Action_ApplyDescriptor>
            </Sequence>
          </Objective>
        </ObjectiveSet>
      </Step>
    </Steps>
  </QuestDefinition>

