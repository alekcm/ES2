    <Steps>
      <Step Name="Step1">
        <ObjectiveSet>
          <Objective Name="Reveal_Constellation">
            <Sequence>
              <Action_RevealEntities NewExplorationState="Owned">
                <Input_Empires VarName="$CurrentEmpire"/>
                <Input_TargetSystems VarName="$SystemsNearHomeSystem"/>
              </Action_RevealEntities>
            </Sequence>
          </Objective>
        </ObjectiveSet>
      </Step>
    </Steps>
