        </ObjectiveSet>

      </Step>
    </Steps>
  </QuestDefinition>

  <QuestDefinition Name="FactionTraitRevealConstellationMany" Category="Vision" SubCategory="Trait" TriggeringProbability="1" MinimumTurn="0">
    
