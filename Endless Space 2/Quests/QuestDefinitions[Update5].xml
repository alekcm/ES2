            <Var VarName="$RemnantPop"   StringValue="AffinityRemnant"/>
            <Var VarName="$Amount01" IntValue="2"/>
            <Var VarName="$Amount02" IntValue="10"/>
            <!--Choice2: decrease dust -->
            <Var VarName="$EffectName2"  StringValue="EventEffect111"/>
            <Var VarName="$EventName2"   StringValue="PopulationPoliticalEventNarrative79"/>
            <Var VarName="$EffectGUID2"/>

            <Var VarName="$DescriptorChapter1"  StringValue="QuestDescriptorRemnantAccepted"/>
            <Var VarName="$DescriptorChapter2"  StringValue="QuestDescriptorChapter2Done"/>
        </Vars>

        <!--============ PREREQUISITES ============-->

        <Prerequisites Target="$(Empire)">          
            <InterpreterPrerequisite Flags="Prerequisite">
                Path(Context,@'ClassEmpire/ClassResearch,TechnologyDefenseModule1ProjectileEnhancer1')
                or Path(Context,@'ClassEmpire/ClassResearch,TechnologyWeaponModule3')
                or Path(Context,@'ClassEmpire/ClassResearch,TechnologyDefenseModule2')
                or Path(Context,@'ClassEmpire/ClassResearch,TechnologyWeaponModule2')
                or Path(Context,@'ClassEmpire/ClassResearch,TechnologyWeaponModule4')
                or Path(Context,@'ClassEmpire/ClassResearch,TechnologyWeaponModule5')
            </InterpreterPrerequisite>
            <QuestStatePrerequisite Flags="Prerequisite" QuestDefinitionName="EventRandom14" QuestState="Completed"/>
            <QuestStatePrerequisite Inverted="true" Flags="Prerequisite" QuestDefinitionName="EventRandom16" QuestState="InProgress"/>
            <QuestStatePrerequisite Inverted="true" Flags="Prerequisite" QuestDefinitionName="EventRandom16" QuestState="Completed"/>
            <QuestStatePrerequisite Inverted="true" Flags="Prerequisite" QuestDefinitionName="EventRandom16" QuestState="Failed"/>
            <PathPrerequisite Flags="Prerequisite">ClassEmpire,QuestDescriptorRemnantAccepted</PathPrerequisite>
            <DownloadableContentPrerequisite Flags="Prerequisite,Discard">Update5</DownloadableContentPrerequisite>
        </Prerequisites>

        <!--============ STEPS ============-->
        <Steps>
            <Step Name="Step1">
                <Choice DefaultChoiceIndex="0">
                    <ChoiceItem ObjectiveSetIndex="0"/>
                    <ChoiceItem ObjectiveSetIndex="1"/>
                </Choice>
                <!--============ STEP 1 ============-->
                <ObjectiveSet>
                    <StartActions>
                        <Action_ApplyQuestEffect LogAction="true">
                            <Input_EffectName VarName="$EffectName1"/>
                            <Input_Target VarName="$EffectTarget1"/>
                            <Output_GUID VarName="$EffectGUID1"/>
                        </Action_ApplyQuestEffect>                      
                        <Action_TriggerPopulationEvent LogAction="true" LocalizationKey="%EventCuriosity032PopulationTitle">
                            <Input_Empire VarName="$EffectTarget1"/>
                            <Input_Target VarName="$EffectTarget1"/>
                            <Input_PopulationEventDefinition VarName="$EventName1"/>
                        </Action_TriggerPopulationEvent>
                    </StartActions>
                    <Objective Name="Step1_Objective1">
                        <Sequence>
                            <Decorator_QuestEffectFinished>
                                <Input_GUID VarName="$EffectGUID1"/>
                            </Decorator_QuestEffectFinished>
                            <Action_ApplyDescriptor Remove="true">
                                <Input_DescriptorName VarName="$DescriptorChapter1"/>
                                <Input_Targets VarName="$EffectTarget1"/>
                            </Action_ApplyDescriptor>
                            <Action_ApplyDescriptor>
                                <Input_DescriptorName VarName="$DescriptorChapter2"/>
                                <Input_Targets VarName="$EffectTarget1"/>
                            </Action_ApplyDescriptor>
                        </Sequence>
                    </Objective>
                </ObjectiveSet>

                <ObjectiveSet>
                    <StartActions>
                        <Action_ApplyQuestEffect LogAction="true">
                            <Input_EffectName VarName="$EffectName2"/>
                            <Input_Target VarName="$EffectTarget1"/>
                            <Output_GUID VarName="$EffectGUID2"/>
                        </Action_ApplyQuestEffect>
                        <Action_TriggerPopulationEvent LogAction="true" LocalizationKey="%EventPolitical17BisPopulationTitle">
                            <Input_Empire VarName="$EffectTarget1"/>
                            <Input_Target VarName="$EffectTarget1"/>
                            <Input_PopulationEventDefinition VarName="$EventName2"/>
                        </Action_TriggerPopulationEvent>
                    </StartActions>
                    <Objective Name="Step2_Objective1">
                        <Sequence>
                            <Decorator_QuestEffectFinished>
                                <Input_GUID VarName="$EffectGUID2"/>
                            </Decorator_QuestEffectFinished>
                            <Action_ApplyDescriptor Remove="true">
                                <Input_DescriptorName VarName="$DescriptorChapter1"/>
                                <Input_Targets VarName="$EffectTarget1"/>
                            </Action_ApplyDescriptor>
                            <Action_ApplyDescriptor>
                                <Input_DescriptorName VarName="$DescriptorChapter2"/>
                                <Input_Targets VarName="$EffectTarget1"/>
                            </Action_ApplyDescriptor>
                        </Sequence>
                    </Objective>
                </ObjectiveSet>
            </Step>
        </Steps>
    </QuestDefinition>

