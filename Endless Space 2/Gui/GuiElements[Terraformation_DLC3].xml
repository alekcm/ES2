        <AltTitle>%PlanetTypeFakeTitle</AltTitle>
    </ExtendedGuiElement>

    <ExtendedGuiElement Name="PlanetTerraformationFromLargeFakeToHugeFake">
        <Title>%PlanetTerraformationFromLargeFakeToHugeFakeTitle</Title>
        <Description>%PlanetTerraformationFromLargeFakeToHugeFakeDescription</Description>
