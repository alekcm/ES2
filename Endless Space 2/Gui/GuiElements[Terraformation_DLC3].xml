            <Icon Size="Small" Path="Bitmaps/Dynamic/Planets/PlanetTypeFakeHugeLarge"/>
            <Icon Size="Large" Path="Bitmaps/Dynamic/Planets/PlanetTypeFakeHugeLarge"/>
