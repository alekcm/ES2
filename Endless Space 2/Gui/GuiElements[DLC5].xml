  <!--  Template for quests GUI
  
    The [  KEY  ] is the quest title in lowercase with '_' replacing the spaces.  
   
    KEY-Title
    KEY-Description
    KEY-Objective
    KEY-ObjectiveTitle
    KEY-ObjectiveDescription
    KEY-ObjectiveTooltip
    KEY-Outcome
    KEY-OutcomeFailed
    Dummy_KEY
  
    <QuestGuiElement Name="[  KEY  ]">
    <Title>%[  KEY  ]-Title</Title>
    <Description>%[  KEY  ]-Description</Description>
    <Icons>
      <Icon Path="Bitmaps/Dynamic/DLC5/[  KEY  ]" Size="Quest" />
    </Icons>
    <Steps>
      <Step Name="Step1">
        <ObjectiveSet Name="Step1_Objective1" Politics="Politics03">
          <Title>%[  KEY  ]-ObjectiveTitle</Title>
          <Description>%[  KEY  ]-ObjectiveDescription</Description>
          <TooltipDescription>%[  KEY  ]-ObjectiveTooltip</TooltipDescription>
          <OutcomeCompleted>%[  KEY  ]-Outcome</OutcomeCompleted>
          <OutcomeFailed>%[  KEY  ]-OutcomeFailed</OutcomeFailed>
          <Objective Name="Step1_Objective1">%[  KEY  ]-Objective</Objective>
        </ObjectiveSet>
      </Step>
    </Steps>
    </QuestGuiElement>
  
  -->

