  <!-- From DLC4 "FactionTraitScienceReduction"-->
  <PropertyFilteringRuleDefinition Name="RuleCanUseRawPlanetScience" Category="Empire">
    <InterpreterPrerequisite>Property(Context, CanUseRawPlanetScience) ge 1</InterpreterPrerequisite>
    <PropertyName>RecipeIngredientEffectTier2Luxury12Bis</PropertyName>
  </PropertyFilteringRuleDefinition>

  <PropertyFilteringRuleDefinition Name="RuleCannotUseRawPlanetScience" Category="Empire">
    <InterpreterPrerequisite>Property(Context, CannotUseRawPlanetScience) ge 1</InterpreterPrerequisite>
    <!--<PropertyName>PlanetRawScience</PropertyName>-->
    <!-- We could hide all "research per pop" modifiers. If we want to, just uncomment this line. -->
    <PropertyName>RecipeIngredientEffectTier2Luxury12</PropertyName>
  </PropertyFilteringRuleDefinition>



