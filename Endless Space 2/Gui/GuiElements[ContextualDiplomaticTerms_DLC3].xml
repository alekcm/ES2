            <Icon Size="Small" Path="CategoryContextualTerm" />
            <Icon Size="SmallExtended" Path="CategoryContextualTermNew" />
        </Icons>
        <TermTitle>%ContextualHackingTraceTermTitle</TermTitle>
        <TermDescription>%ContextualHackingTraceTermDescription</TermDescription>
    </ContextualDiplomaticTermGuiElement>

