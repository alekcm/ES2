      <Color Red="219" Green="219" Blue="219" Alpha="255" />
    </ExtendedGuiElement>
  
    <ExtendedGuiElement Name="ShipStatusKamikazed">
        <Description>%BattleShipItemStatusKamikazedDescription</Description>
